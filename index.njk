---
permalink: /
---
{#
  Página inicial.

  Estrutura:
    1. nav fixo (nav.njk)
    2. hero — o texto mais recente em destaque, como um frame de filme
    3. contact sheet — todos os textos em tiras de 4 frames
    4. temas — atalhos para a galeria filtrada
    5. rodapé

  Dados: collections.articles (definida no .eleventy.js), ordenada do mais
  recente para o mais antigo; cada item já traz frameNumber e colorClass.
#}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>br.trombin</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Playfair+Display:ital@0;1&display=swap" rel="stylesheet">
<style>
/* ══ TOKENS ═══════════════════════════════════════════════════════════════
   Paleta inspirada no filme Kodak Ektar 100. As cores "-text" são versões
   mais claras dos acentos, usadas só em texto pequeno: o vermelho Ektar
   puro não atinge contraste 4.5:1 (WCAG AA) sobre os fundos escuros. */
:root {
  --black: #1a2a1e;           /* fundo da página (verde quase preto) */
  --film-black: #162318;
  --bg-dark: #162318;         /* fundo da seção de temas */
  --green-border: #2e4a32;
  --strip-bg: #2a1e10;        /* marrom da base do filme */
  --frame-border: #0d0a05;
  --perf-hole: #000;

  --ektar-red: #c8341a;       /* botões, bordas, detalhes decorativos */
  --ektar-red-text: #f07050;  /* rótulos em vermelho (contraste ≥ 5:1) */
  --ektar-orange: #d4621e;
  --ektar-blue: #1a3a5c;
  --ektar-sky: #2e6a9e;
  --ektar-warm: #e8c87a;

  --cream: #f0e8d0;           /* títulos */
  --cream-dim: #b8a880;       /* texto secundário (6:1) */
  --text-dim: #a8987a;        /* texto terciário — mínimo legível (5:1) */

  --mono: 'Share Tech Mono', monospace;
  --serif: 'Playfair Display', serif;
}

/* ══ RESET + BASE ═════════════════════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  background: var(--black);
  color: var(--cream);
  font-family: var(--mono);
  min-height: 100vh;
  overflow-x: hidden;
}

/* Grão de filme: ruído SVG fixo por cima de tudo, sem capturar cliques */
body::after {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 999;
  pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  opacity: .06;
  mix-blend-mode: screen;
}

/* ══ NAV (markup em _includes/nav.njk) ════════════════════════════════════ */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: .85rem 2rem;
  background: rgba(26,42,30,.94);
  backdrop-filter: blur(6px);
  border-bottom: 1px solid #243a28;
}

.logo {
  font-family: var(--mono);
  font-size: .95rem;
  letter-spacing: .2em;
  color: var(--cream);
  text-decoration: none;
}
.logo em { color: var(--ektar-red); font-style: normal; }

.nav-right {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.nav-right a {
  font-family: var(--mono);
  font-size: .8rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--cream-dim);
  text-decoration: none;
  transition: color .2s;
}
.nav-right a:hover { color: var(--cream); }

/* links externos (Substack / Instagram) em formato de etiqueta */
.nav-pill {
  border: 1px solid var(--ektar-red);
  padding: .22rem .7rem;
  color: var(--ektar-red-text) !important;
}
.nav-right a.active { color: var(--cream); }

/* botão hambúrguer — visível só em mobile (ver @media) */
.nav-hamburger {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  /* padding grande + margem negativa: área de toque de ~44px sem aumentar o nav */
  padding: 14px 11px;
  margin: -10px -7px;
  z-index: 101;
}
.nav-hamburger span {
  width: 22px; height: 2px;
  background: var(--cream);
  display: block;
  transition: transform .25s, opacity .2s;
}
/* estado aberto: as três barras viram um X */
.nav-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.nav-hamburger.open span:nth-child(2) { opacity: 0; }
.nav-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* ══ HERO — texto em destaque ═════════════════════════════════════════════
   Um "frame" de filme em tela cheia: perfurações em cima e embaixo,
   foto à esquerda, título e chamada à direita. */
.hero {
  padding-top: 52px; /* altura do nav fixo */
  background: var(--strip-bg);
  position: relative;
  overflow: hidden;
}

/* faixa de perfurações; os furos (.perf) são gerados por JS */
.perfs {
  height: 22px;
  background: var(--strip-bg);
  display: flex;
  align-items: center;
  gap: 0;
  padding: 0 4px;
  position: relative;
  z-index: 2;
}

.perf {
  width: 14px;
  height: 10px;
  background: var(--perf-hole);
  border: 1px solid #1a1408;
  border-radius: 2px;
  margin-right: 18px;
  flex-shrink: 0;
}

/* foto | informações — lado a lado no desktop, empilhados no mobile */
.hero-frame {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  min-height: calc(100vh - 100px); /* tela inteira menos nav e perfurações */
  border-top: 2px solid var(--frame-border);
  border-bottom: 2px solid var(--frame-border);
  position: relative;
}

/* legenda de borda do filme ("▷ 043 … 99exp"), sobre a faixa inferior */
.frame-label {
  position: absolute;
  bottom: -21px;
  left: 12px;
  font-size: .72rem;
  letter-spacing: .2em;
  color: #ff9a2e;
  font-family: var(--mono);
  z-index: 10;
}

.hero-photo {
  position: relative;
  overflow: hidden;
  background: #1a2e20;
  border-right: 2px solid var(--frame-border);
}

.hero-photo-inner {
  width: 100%;
  height: 100%;
  min-height: calc(100vh - 100px);
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 1.5rem;
  filter: contrast(1.12) saturate(1.3);
}

.hero-photo-inner img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: contrast(1.1) saturate(1.25);
  display: block;
}

/* carimbo laranja estilo "data back" de câmera analógica */
.ektar-stamp {
  position: absolute;
  bottom: 12px;
  right: 14px;
  font-family: var(--mono);
  font-size: clamp(.8rem, 1.1vw, .95rem);
  color: #ff7800;
  letter-spacing: .14em;
  text-shadow: 0 0 6px rgba(255,120,0,.9), 0 0 14px rgba(255,80,0,.5);
  z-index: 2;
  line-height: 1.6;
  text-align: right;
}

.hero-info {
  padding: 3.5rem 3rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: var(--strip-bg);
  position: relative;
}

/* linha "br.trombin — frame 043" acima do título */
.strip-index {
  font-size: .78rem;
  letter-spacing: .22em;
  color: var(--ektar-red-text);
  text-transform: uppercase;
  margin-bottom: 2rem;
}

.hero-title {
  font-family: var(--serif);
  font-size: clamp(2rem, 3.6vw, 3.6rem);
  line-height: 1.1;
  color: var(--cream);
  font-style: normal;
  font-weight: 700;
  margin-bottom: 1.8rem;
  letter-spacing: -.01em;
}

.hero-excerpt {
  font-family: var(--serif);
  font-size: 1.1rem;
  line-height: 1.75;
  color: #cbbd9c;
  max-width: 36ch;
  margin-bottom: 2.5rem;
  font-style: italic;
}

/* data · tipo · câmera */
.meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: .5rem 1rem;
  margin-bottom: 2.5rem;
  font-size: .78rem;
  letter-spacing: .14em;
  color: var(--text-dim);
  text-transform: uppercase;
}

.meta-dot {
  width: 3px;
  height: 3px;
  background: var(--ektar-red);
  border-radius: 50%;
}

.btn-read {
  display: inline-block;
  font-family: var(--mono);
  font-size: .82rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: #fffaf0; /* quase branco sobre vermelho: 5:1 (o verde-escuro dava 2.8:1) */
  background: var(--ektar-red);
  padding: .8rem 1.6rem;
  text-decoration: none;
  align-self: flex-start;
  transition: background .2s;
}
.btn-read:hover { background: var(--ektar-orange); }

/* texto vertical na lateral direita ("Kodak Ektar · ISO 100") — só desktop */
.exposure-data {
  position: absolute;
  right: 1rem;
  top: 50%;
  transform: translateY(-50%);
  font-size: .7rem;
  letter-spacing: .15em;
  color: var(--text-dim);
  writing-mode: vertical-rl;
  text-transform: uppercase;
  line-height: 2;
}

/* entrada em cascata dos elementos do hero (cada um com um atraso maior) */
@keyframes fadeUp { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:translateY(0); } }
.hero-info > * { animation: fadeUp .7s ease both; }
.strip-index { animation-delay: .1s; }
.hero-title { animation-delay: .22s; }
.hero-excerpt { animation-delay: .35s; }
.meta-row { animation-delay: .44s; }
.btn-read { animation-delay: .54s; }

/* ══ CONTACT SHEET — arquivo de todos os textos ═══════════════════════════ */

/* título da seção: "contact sheet ───────── br.trombin 2024–2025" */
.sheet-header {
  padding: 3rem 2rem 1.2rem;
  display: flex;
  align-items: center;
  gap: 1.5rem;
  border-top: 1px solid #243a28;
}

.sheet-header h2 {
  font-family: var(--mono);
  font-size: .8rem;
  font-weight: 400;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--ektar-red-text);
  white-space: nowrap;
}

.sheet-header-line {
  flex: 1;
  height: 1px;
  background: #2a2218;
}

.sheet-header-right {
  font-size: .72rem;
  letter-spacing: .14em;
  color: var(--text-dim);
  text-transform: uppercase;
  white-space: nowrap;
}

.contact-sheet {
  background: var(--black);
  padding: 1.5rem 2rem 3rem;
  border-top: 2px solid #000;
  border-bottom: 2px solid #000;
}

/* Uma tira = 4 frames entre duas faixas de perfuração.
   .strip-row   → janela (no mobile vira área de rolagem horizontal)
   .strip-inner → a tira em si (perfurações + frames) */
.strip-row {
  overflow-x: hidden;
  margin-bottom: 1.2rem;
}

.strip-inner {
  display: flex;
  flex-direction: column;
}

/* faixa de furinhos horizontal — topo e base da tira, desenhada com
   um degradê repetido (sem elementos extras no HTML) */
.strip-perfs-h {
  height: 18px;
  background: #2a1e10;
  flex-shrink: 0;
  position: relative;
}
.strip-perfs-h::before {
  content: '';
  position: absolute;
  top: 20%;
  left: 0;
  right: 0;
  height: 60%;
  background: repeating-linear-gradient(
    to right,
    transparent 0, transparent 5px,
    #000 5px, #000 17px,
    transparent 17px, transparent 22px
  );
}

.strip-frames {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 5px;
  background: #0c0905;
  padding: 6px;
}

/* card = frame + legenda abaixo */
.film-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.film-frame {
  position: relative;
  aspect-ratio: 3/2;
  overflow: hidden;
  background: #0f1a12;
  cursor: pointer;
  text-decoration: none;
  display: block;
}

.film-frame:hover .frame-ph img {
  filter: contrast(1.2) saturate(1.4) brightness(.82);
}

/* área da foto; sem hero_image recebe um degradê (.c1 … .c8) */
.frame-ph {
  width: 100%;
  height: 100%;
}

.frame-ph img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: contrast(1.08) saturate(1.15);
  transition: filter .35s;
}

/* título sempre visível abaixo do frame, estilo rebate (borda do filme) */
.frame-caption {
  font-family: var(--mono);
  font-size: clamp(.75rem, .9vw, .85rem);
  letter-spacing: .04em;
  line-height: 1.4;
  color: #e08a3c;
  background: #160e04;
  border-top: 1px solid #0c0703;
  padding: .35rem .5rem .3rem;
  text-decoration: none;
  /* corta o título em no máximo 2 linhas, com reticências */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  transition: color .2s;
}
.frame-caption:hover { color: #ffb060; }

/* número do frame, canto superior esquerdo da miniatura */
.frame-idx {
  position: absolute;
  top: 6px;
  left: 7px;
  font-size: .7rem;
  color: #ff9a2e;
  font-family: var(--mono);
  letter-spacing: .06em;
  text-shadow: 0 0 4px #000, 0 0 2px #000;
  pointer-events: none;
  z-index: 2;
}

/* local + ano/mês, canto inferior esquerdo da miniatura */
.frame-meta {
  position: absolute;
  bottom: 6px;
  left: 7px;
  font-family: var(--mono);
  font-size: .7rem;
  color: #ff9a2e;
  letter-spacing: .06em;
  line-height: 1.45;
  text-shadow: 0 0 4px #000, 0 0 2px #000;
  pointer-events: none;
  z-index: 2;
}

/* degradês de placeholder para textos sem foto (classe sorteada no .eleventy.js) */
.c1 { background: linear-gradient(135deg, var(--ektar-blue) 0%, #6a8a6a 60%, var(--ektar-orange) 100%); }
.c2 { background: linear-gradient(135deg, #4a6040 0%, #8a9a5a 50%, var(--ektar-warm) 100%); }
.c3 { background: linear-gradient(135deg, #3a2820 0%, var(--ektar-red) 60%, var(--ektar-orange) 100%); }
.c4 { background: linear-gradient(135deg, var(--ektar-sky) 0%, #7aaa8a 50%, #c8a060 100%); }
.c5 { background: linear-gradient(135deg, #1a2030 0%, var(--ektar-blue) 40%, #8aaa7a 100%); }
.c6 { background: linear-gradient(135deg, #6a4030 0%, #a87050 60%, var(--ektar-warm) 100%); }
.c7 { background: linear-gradient(135deg, #2a4020 0%, #5a8040 60%, var(--ektar-warm) 100%); }
.c8 { background: linear-gradient(135deg, var(--ektar-red) 0%, #6a3020 50%, #2a1810 100%); }

/* ══ TEMAS ════════════════════════════════════════════════════════════════ */
.themes-section {
  padding: 3rem 2rem 3.5rem;
  border-top: 1px solid var(--green-border);
  background: var(--bg-dark);
}
.themes-label {
  font-family: var(--mono);
  font-size: .78rem;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: var(--ektar-red-text);
  display: block;
  margin-bottom: 1.2rem;
}
.themes-list {
  display: flex;
  flex-wrap: wrap;
  gap: .6rem;
}
/* etiqueta de tema — abre a galeria já filtrada (?theme=…) */
.theme-pill {
  font-family: var(--mono);
  font-size: .78rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--cream-dim);
  border: 1px solid var(--green-border);
  padding: .4rem .85rem;
  text-decoration: none;
  transition: color .2s, border-color .2s;
}
.theme-pill:hover {
  color: var(--cream);
  border-color: var(--cream-dim);
}

/* ══ RODAPÉ ═══════════════════════════════════════════════════════════════ */
footer {
  border-top: 1px solid #243a28;
  padding: 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.5rem;
}

.footer-logo {
  font-family: var(--mono);
  font-size: .85rem;
  letter-spacing: .15em;
  color: var(--cream);
}
.footer-logo em { color: var(--ektar-red); font-style: normal; }

.footer-links { display: flex; gap: 1.5rem; }
.footer-links a {
  font-size: .75rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--text-dim);
  text-decoration: none;
  transition: color .2s;
}
.footer-links a:hover { color: var(--cream); }

.footer-copy {
  font-size: .7rem;
  letter-spacing: .1em;
  color: var(--text-dim);
  text-transform: uppercase;
}

/* ══ RESPONSIVO (≤ 768px: celular e tablet em pé) ═════════════════════════ */
@media (max-width: 768px) {
  /* nav: links viram painel suspenso aberto pelo hambúrguer */
  nav { padding: .8rem 1.2rem; }
  .nav-hamburger { display: flex; }
  .nav-right {
    display: none;
    position: fixed;
    top: 49px; left: 0; right: 0; /* 49px = altura do nav mobile */
    background: rgba(22,35,24,.98);
    flex-direction: column;
    align-items: flex-start;
    padding: 1.8rem 2rem;
    gap: 1.4rem;
    border-bottom: 1px solid #243a28;
    z-index: 102;
  }
  .nav-right.open { display: flex; }
  .nav-right a { font-size: 1rem; letter-spacing: .14em; }

  /* hero: foto em cima, informações embaixo */
  .hero-frame { grid-template-columns: 1fr; min-height: auto; }
  .hero-photo { border-right: none; border-bottom: 2px solid var(--frame-border); }
  .hero-photo-inner { min-height: 56vw; }
  .hero-info { padding: 2rem 1.5rem; }
  .exposure-data { display: none; }

  .sheet-header { padding: 2.5rem 1.2rem 1.2rem; gap: 1rem; }

  /* contact sheet: cada tira rola na horizontal, como um filme passando */
  .contact-sheet { padding: 1rem 0 2rem; }
  /* a tira inteira (perfs + frames) rola como unidade */
  .strip-row {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .strip-row::-webkit-scrollbar { display: none; }
  /* max-content: a tira fica da largura dos 4 frames, e as faixas de
     perfuração acompanham essa largura */
  .strip-inner {
    display: inline-flex;
    flex-direction: column;
    min-width: max-content;
  }
  .strip-perfs-h {
    width: 100%;
  }
  /* frame com 72% da tela (deixa o próximo aparecendo), limitado a 340px
     para não ficar gigante em tablets */
  .strip-frames {
    grid-template-columns: repeat(4, min(72vw, 340px));
    gap: 4px;
    padding: 4px;
  }
  .frame-caption { font-size: .8rem; }
  .strip-perfs-h::before {
    background: repeating-linear-gradient(
      to right,
      transparent 0, transparent 5px,
      #000 5px, #000 13px,
      transparent 13px, transparent 18px
    );
  }

  .themes-section { padding: 2.5rem 1.2rem 3rem; }

  footer { flex-direction: column; gap: 1rem; text-align: center; }
  .footer-copy { display: none; }
}

/* telas estreitas: esconde o "br.trombin 2024–2025" do título da seção */
@media (max-width: 420px) {
  .sheet-header-right { display: none; }
}
</style>
</head>
<body>

{% include "nav.njk" %}

{% if collections.articles and collections.articles.length > 0 %}
{# o texto mais recente é o destaque do hero #}
{% set featured = collections.articles[0] %}

{# ── HERO ──────────────────────────────────────────────────────────────── #}
<section class="hero">
  <div class="perfs" id="perfs-top"></div>

  <div class="hero-frame">
    {# foto do destaque — ou um degradê, se o texto não tiver hero_image #}
    <div class="hero-photo">
      <div class="hero-photo-inner" {% if not featured.data.hero_image %}style="background:{{ featured.data.hero_gradient | default('linear-gradient(180deg, #1a3a5c 0%, #2e6a9e 35%, #8aaa6a 58%, #d4621e 80%, #c8341a 100%)') }}"{% endif %}>
        {% if featured.data.hero_image %}
        <img src="{{ featured.data.hero_image | url }}" alt="{{ featured.data.title }}">
        {% endif %}
        <div class="ektar-stamp">
          {{ featured.data.location }}<br>
          {{ featured.data.date | dateStamp }}<br>
          {{ featured.data.aperture }}&nbsp;&nbsp;{{ featured.data.speed }}
        </div>
      </div>
    </div>

    {# título, chamada, metadados e botão #}
    <div class="hero-info">
      <p class="strip-index">br.trombin &mdash; frame {{ featured.data.frameNumber }}</p>
      <h1 class="hero-title">{{ featured.data.title }}</h1>
      {% if featured.data.lead %}
      <p class="hero-excerpt">{{ featured.data.lead }}</p>
      {% endif %}
      <div class="meta-row">
        <span>{{ featured.data.date | dateLong }}</span>
        <span class="meta-dot"></span>
        <span>{{ featured.data.type | default("leitura") }}</span>
        <span class="meta-dot"></span>
        <span>{{ featured.data.camera }}</span>
      </div>
      <a href="{{ featured.url }}" class="btn-read">{% if featured.data.type == "ensaio" %}abrir ensaio{% else %}abrir texto{% endif %}</a>
      <div class="exposure-data">{{ featured.data.film }} &nbsp;&middot;&nbsp; ISO 100</div>
    </div>

    <span class="frame-label">▷ {{ featured.data.frameNumber }} &nbsp; {{ featured.data.film }} &nbsp; 99exp</span>
  </div>

  <div class="perfs" id="perfs-bot"></div>
</section>

{# ── CONTACT SHEET ─────────────────────────────────────────────────────── #}
<div class="sheet-header" id="arquivo">
  <h2>contact sheet</h2>
  <div class="sheet-header-line"></div>
  <span class="sheet-header-right">br.trombin &nbsp; 2024&ndash;2025</span>
</div>

<div class="contact-sheet">
  {# o filtro chunk(4) (do .eleventy.js) divide os textos em tiras de 4 frames #}
  {% for chunk in collections.articles | chunk(4) %}
  <div class="strip-row">
    <div class="strip-inner">
      <div class="strip-perfs-h"></div>
      <div class="strip-frames">
        {% for article in chunk %}
        <div class="film-card">
          <a class="film-frame" href="{{ article.url }}" aria-label="{{ article.data.title }}">
            {% if article.data.hero_image %}
            <div class="frame-ph"><img src="{{ article.data.hero_image | url }}" alt="{{ article.data.title }}" loading="lazy"></div>
            {% else %}
            <div class="frame-ph {{ article.data.colorClass }}"></div>
            {% endif %}
            <span class="frame-idx">{{ article.data.frameNumber }}</span>
            <div class="frame-meta">
              {{ article.data.location | locShort }}<br>{{ article.data.date | dateYM }}
            </div>
          </a>
          {# tabindex -1: o frame acima já é o link focável; evita foco duplicado no teclado #}
          <a class="frame-caption" href="{{ article.url }}" tabindex="-1">{{ article.data.title }}</a>
        </div>
        {% endfor %}
      </div>
      <div class="strip-perfs-h"></div>
    </div>
  </div>
  {% endfor %}
</div>

{% else %}
{# Placeholder quando não há artigos ainda #}
<section class="hero">
  <div class="perfs" id="perfs-top"></div>
  <div class="hero-frame">
    <div class="hero-photo">
      <div class="hero-photo-inner" style="background:linear-gradient(180deg,#1a3a5c 0%,#2e6a9e 35%,#8aaa6a 58%,#d4621e 80%,#c8341a 100%)">
      </div>
    </div>
    <div class="hero-info">
      <p class="strip-index">br.trombin &mdash; frame 000</p>
      <h1 class="hero-title">O que não<br>coube aqui<br>ficou em mim</h1>
    </div>
  </div>
  <div class="perfs" id="perfs-bot"></div>
</section>
{% endif %}

{# ── TEMAS ───────────────────────────────────────────────────────────────
   uniqueThemes (do .eleventy.js) junta os temas de todos os textos,
   sem repetição e em ordem alfabética. #}
{% set allThemes = collections.articles | uniqueThemes %}
{% if allThemes and allThemes.length > 0 %}
<section class="themes-section">
  <span class="themes-label">explorar por tema</span>
  <div class="themes-list">
    {% for theme in allThemes %}
    <a href="{{ '/galeria.html' | url }}?theme={{ theme }}" class="theme-pill">{{ theme }}</a>
    {% endfor %}
  </div>
</section>
{% endif %}

<footer>
  <span class="footer-logo">br<em>.</em>trombin</span>
  <div class="footer-links">
    <a href="https://naocabe.substack.com" target="_blank" rel="noopener">Não Cabia</a>
    <a href="https://www.instagram.com/brtrombin" target="_blank" rel="noopener">Instagram</a>
    <a href="{{ '/sobre/' | url }}">sobre</a>
  </div>
  <span class="footer-copy">Kodak Ektar 100 &nbsp;&middot;&nbsp; Porto Alegre RS &nbsp;&middot;&nbsp; 2024&ndash;2025</span>
</footer>

<script>
// ── Menu hambúrguer (mobile) ─────────────────────────────────────────────
(function() {
  const toggle = document.getElementById('nav-toggle');
  const menu   = document.getElementById('nav-menu');
  if (!toggle || !menu) return;

  // abre/fecha ao tocar no botão
  toggle.addEventListener('click', function() {
    const open = menu.classList.toggle('open');
    toggle.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', String(open));
  });

  // fecha ao tocar fora do menu
  document.addEventListener('click', function(e) {
    if (!menu.contains(e.target) && !toggle.contains(e.target)) {
      menu.classList.remove('open');
      toggle.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });

  // fecha ao escolher um link
  menu.querySelectorAll('a').forEach(function(a) {
    a.addEventListener('click', function() {
      menu.classList.remove('open');
      toggle.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    });
  });
})();

// ── Perfurações do hero ──────────────────────────────────────────────────
// Preenche a faixa com furos suficientes para a largura atual da janela
// (cada furo ocupa 32px: 14 de largura + 18 de margem).
function makePerfs(id) {
  const el = document.getElementById(id);
  if (!el) return;
  const n = Math.ceil(window.innerWidth / 32) + 2;
  el.innerHTML = Array(n).fill('<div class="perf"></div>').join('');
}
makePerfs('perfs-top');
makePerfs('perfs-bot');
window.addEventListener('resize', () => { makePerfs('perfs-top'); makePerfs('perfs-bot'); });

// ── Auto-scroll suave nas tiras — apenas mobile ──────────────────────────
// Cada tira desliza devagar para a esquerda enquanto está visível na tela,
// e volta ao início quando chega ao fim. Pausa quando o usuário toca nela.
(function() {
  if (window.innerWidth > 768) return;

  const SPEED = 0.4; // px por frame (~24px/s em 60fps)
  const PAUSE_AFTER_TOUCH = 3000; // ms de pausa após interação

  document.querySelectorAll('.strip-row').forEach(row => {
    let rafId = null;        // id do requestAnimationFrame em andamento
    let paused = false;      // true enquanto o usuário interage
    let resumeTimer = null;  // timer que retoma o movimento após o toque
    let visible = false;     // a tira está dentro da tela?

    // um passo da animação: chamado a cada frame do navegador
    function scroll() {
      if (!paused && visible) {
        const inner = row.querySelector('.strip-inner') || row;
        const maxScroll = inner.scrollWidth - row.clientWidth;
        if (row.scrollLeft >= maxScroll) {
          // chegou no fim: pausa 1s e volta pro início suavemente
          paused = true;
          setTimeout(() => {
            row.scrollTo({ left: 0, behavior: 'smooth' });
            setTimeout(() => { paused = false; }, 600);
          }, 1000);
        } else {
          row.scrollLeft += SPEED;
        }
      }
      rafId = requestAnimationFrame(scroll);
    }

    function pauseTemporarily() {
      paused = true;
      clearTimeout(resumeTimer);
      resumeTimer = setTimeout(() => { paused = false; }, PAUSE_AFTER_TOUCH);
    }

    row.addEventListener('touchstart', pauseTemporarily, { passive: true });
    row.addEventListener('mouseenter', () => { paused = true; });
    row.addEventListener('mouseleave', () => { paused = false; });

    // só anima a tira quando pelo menos 30% dela está visível
    const observer = new IntersectionObserver(entries => {
      visible = entries[0].isIntersecting;
      if (visible && !rafId) rafId = requestAnimationFrame(scroll);
    }, { threshold: 0.3 });

    observer.observe(row);
  });
})();
</script>
</body>
</html>
