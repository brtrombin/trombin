permalink: /galeria.html
---
{#
  Galeria fotográfica.

  Diferente das outras páginas, o conteúdo é montado no navegador:
    1. o Eleventy escreve a lista de fotos como JSON dentro do <script>
       (capas dos textos + fotos avulsas de _data/gallery.json)
    2. o JS monta a barra de filtros, o rolo de filme e o lightbox

  Aceita ?theme=nome na URL para já abrir filtrada (links de temas da home
  e dos artigos).
#}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>galeria — br.trombin</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Playfair+Display:ital,wght@0,400;1,400&display=swap" rel="stylesheet">
<style>
/* ══ TOKENS ═══════════════════════════════════════════════════════════════
   Mesma paleta dos artigos. As cores "-text" são versões mais claras dos
   acentos, usadas só em texto pequeno para atingir contraste AA. */
:root {
  --bg: #1e2e22;
  --bg-dark: #162318;
  --bg-deeper: #0f1a12;
  --green-border: #2e4a32;
  --green-mid: #243a28;

  --ektar-red: #c8341a;        /* botões, bordas, detalhes decorativos */
  --ektar-red-text: #f07050;   /* rótulos em vermelho */
  --ektar-orange: #d4621e;
  --ektar-amber: #e8a830;

  --cream: #f0e8d0;            /* títulos */
  --cream-dim: #b8a880;        /* texto secundário */
  --cream-ghost: #a09070;      /* texto terciário — mínimo legível */

  --mono: 'Share Tech Mono', monospace;
  --serif: 'Playfair Display', serif;
}

/* ══ RESET + BASE ═════════════════════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--cream);
  font-family: var(--mono);
  min-height: 100vh;
  overflow-x: hidden;
}

/* Grão de filme: ruído SVG fixo por cima de tudo, sem capturar cliques */
body::after {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 998;
  pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  opacity: .05;
  mix-blend-mode: screen;
}

/* ══ NAV (markup em _includes/nav.njk) ════════════════════════════════════ */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: .85rem 2rem;
  background: rgba(30,46,34,.94);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--green-border);
}

.logo {
  font-family: var(--mono);
  font-size: .9rem;
  letter-spacing: .2em;
  color: var(--cream);
  text-decoration: none;
}
.logo em { color: var(--ektar-red); font-style: normal; }

.nav-right { display: flex; align-items: center; gap: 1.4rem; }
.nav-right a {
  font-family: var(--mono);
  font-size: .8rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--cream-dim);
  text-decoration: none;
  transition: color .2s;
}
.nav-right a:hover { color: var(--cream); }
.nav-right a.active { color: var(--ektar-red-text); } /* página atual */

/* links externos (Substack / Instagram) em formato de etiqueta */
.nav-pill {
  border: 1px solid var(--ektar-red);
  padding: .22rem .7rem;
  color: var(--ektar-red-text) !important;
}

/* botão hambúrguer — visível só em mobile (ver @media) */
.nav-hamburger {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  /* padding grande + margem negativa: área de toque de ~44px sem aumentar o nav */
  padding: 14px 11px;
  margin: -10px -7px;
  z-index: 101;
}
.nav-hamburger span {
  width: 22px; height: 2px;
  background: var(--cream);
  display: block;
  transition: transform .25s, opacity .2s;
}
/* estado aberto: as três barras viram um X */
.nav-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.nav-hamburger.open span:nth-child(2) { opacity: 0; }
.nav-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* ══ CABEÇALHO DA PÁGINA ══════════════════════════════════════════════════
   Faixa de perfurações + título/contagem + barra de filtros. */
.page-header {
  padding: 90px 2rem 0; /* 90px: espaço do nav fixo + respiro */
  background: var(--bg-deeper);
  border-bottom: 1px solid var(--green-border);
}

/* faixa decorativa; os furos (.perf) são gerados por JS */
.film-strip {
  height: 24px;
  display: flex;
  align-items: center;
  padding: 0 4px;
  overflow: hidden;
}

.perf {
  width: 13px;
  height: 9px;
  background: #080f0a;
  border: 1px solid var(--green-mid);
  border-radius: 2px;
  margin-right: 17px;
  flex-shrink: 0;
}

.page-title-row {
  padding: 2rem 0 1.5rem;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
}

.page-title {
  font-family: var(--mono);
  font-size: .82rem;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--ektar-red-text);
}

/* "41 frames" — atualizado pelo JS a cada filtro */
.page-count {
  font-family: var(--mono);
  font-size: .75rem;
  letter-spacing: .14em;
  color: var(--cream-ghost);
  text-transform: uppercase;
  white-space: nowrap;
}

/* ══ BARRA DE FILTROS (botões criados por JS, um por tema) ════════════════ */
.filter-bar {
  display: flex;
  gap: .5rem;
  padding-bottom: 1.5rem;
  flex-wrap: wrap;
}

.filter-btn {
  font-family: var(--mono);
  font-size: .75rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--cream-dim);
  background: transparent;
  border: 1px solid var(--green-border);
  padding: .4rem .8rem;
  cursor: pointer;
  white-space: nowrap;
  transition: color .2s, border-color .2s;
}

.filter-btn:hover {
  color: var(--cream);
  border-color: var(--cream-dim);
}

.filter-btn.active {
  color: var(--ektar-red-text);
  border-color: var(--ektar-red);
}

/* ══ ROLO DE FILME ════════════════════════════════════════════════════════
   .film-roll   → todas as tiras
   .roll-strip  → uma tira: perfurações + frames + perfurações
   .roll-frames → os frames da tira (4 no desktop, 2 no mobile) */
.gallery-wrap {
  padding: 2rem;
}

.film-roll {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.roll-strip {
  display: flex;
  flex-direction: column;
  margin-bottom: 1.2rem;
}

/* faixa de furinhos horizontal — topo e base, padrão KS-1870 */
.roll-perfs-h {
  height: 20px;
  background: #2a1e10;
  flex-shrink: 0;
  position: relative;
}
.roll-perfs-h::before {
  content: '';
  position: absolute;
  top: 20%;
  left: 0;
  right: 0;
  height: 60%;
  /* período 22px: gap 6.5px + buraco 9px + gap 6.5px = proporção KS real ~42% buraco */
  background: repeating-linear-gradient(
    to right,
    transparent 0, transparent 6.5px,
    #000 6.5px, #000 15.5px,
    transparent 15.5px, transparent 22px
  );
}

.roll-frames {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 5px;
  padding: 6px;
  background: #0c0905;
}

/* card = frame + legenda abaixo */
.frame-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  cursor: pointer;
}

/* frame = área da foto, proporção 3:2 */
.frame-cell {
  position: relative;
  aspect-ratio: 3/2;
  overflow: hidden;
  background: var(--bg-deeper);
}

.frame-cell img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: contrast(1.08) saturate(1.15);
  transition: filter .35s, transform .35s;
}

/* sempre visível: data + câmera no canto inferior */
.frame-meta {
  position: absolute;
  bottom: 6px;
  left: 7px;
  font-family: var(--mono);
  font-size: clamp(.7rem, .8vw, .8rem);
  color: #ff7800;
  letter-spacing: .1em;
  line-height: 1.5;
  text-shadow: 0 0 5px rgba(255,120,0,.9), 0 0 12px rgba(255,80,0,.4);
  pointer-events: none;
  z-index: 2;
}

/* número do frame no canto superior */
.frame-idx {
  position: absolute;
  top: 6px;
  left: 7px;
  font-family: var(--mono);
  font-size: .7rem;
  color: #ff9a2e;
  letter-spacing: .08em;
  text-shadow: 0 0 4px #000, 0 0 2px #000;
  pointer-events: none;
  z-index: 2;
}

/* hover: só escurece/satura a imagem, sem texto overlay */
.frame-card:hover .frame-cell img {
  filter: contrast(1.15) saturate(1.3) brightness(.88);
  transform: scale(1.03);
}

/* título sempre visível abaixo do frame — estilo rebate (borda do filme) */
.frame-caption {
  font-family: var(--mono);
  font-size: clamp(.75rem, .9vw, .85rem);
  letter-spacing: .04em;
  line-height: 1.4;
  color: #e08a3c;
  background: #160e04;
  border-top: 1px solid #0c0703;
  padding: .35rem .5rem .3rem;
  /* corta o título em no máximo 2 linhas, com reticências */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  transition: color .2s;
}
.frame-card:hover .frame-caption { color: #ffb060; }

/* ══ LIGHTBOX ═════════════════════════════════════════════════════════════
   Painel sobre a página: foto à esquerda, ficha à direita.
   Fica invisível (opacity 0, sem cliques) até receber .open via JS. */
.lightbox {
  position: fixed;
  inset: 0;
  z-index: 500;
  background: rgba(10,16,11,.96);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity .3s;
}

.lightbox.open {
  opacity: 1;
  pointer-events: all;
}

.lb-inner {
  display: grid;
  grid-template-columns: 1fr 340px;
  max-width: 1100px;
  width: 95vw;
  max-height: 90vh;
  background: var(--bg-dark);
  border: 1px solid var(--green-border);
  position: relative;
  overflow: hidden;
}

.lb-photo {
  position: relative;
  overflow: hidden;
  background: var(--bg-deeper);
  min-height: 400px;
}

.lb-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: contrast(1.1) saturate(1.2);
}

/* carimbo laranja (local / data / exposição) sobre a foto */
.lb-stamp {
  position: absolute;
  bottom: 12px;
  right: 14px;
  font-family: var(--mono);
  font-size: clamp(.8rem, 1.1vw, .95rem);
  color: #ff7800;
  letter-spacing: .14em;
  text-shadow: 0 0 6px rgba(255,120,0,.9), 0 0 14px rgba(255,80,0,.5);
  line-height: 1.6;
  text-align: right;
  pointer-events: none;
  z-index: 2;
}

.lb-frame-n {
  position: absolute;
  top: 10px;
  left: 12px;
  font-family: var(--mono);
  font-size: .75rem;
  color: #ff9a2e;
  letter-spacing: .1em;
  text-shadow: 0 0 4px #000, 0 0 2px #000;
  pointer-events: none;
  z-index: 2;
}

/* coluna de informações (rola sozinha se o conteúdo for longo) */
.lb-info {
  padding: 2rem 1.5rem;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  border-left: 1px solid var(--green-border);
}

.lb-eyebrow {
  font-family: var(--mono);
  font-size: .75rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--ektar-red-text);
  margin-bottom: 1rem;
}

.lb-title {
  font-family: var(--serif);
  font-size: 1.5rem;
  font-style: italic;
  color: var(--cream);
  line-height: 1.25;
  margin-bottom: 1rem;
  font-weight: 400;
}

.lb-caption {
  font-family: var(--serif);
  font-size: 1rem;
  line-height: 1.7;
  color: var(--cream-dim);
  font-style: italic;
  margin-bottom: 1.5rem;
  flex: 1; /* empurra a ficha e o botão para o fim da coluna */
}

.lb-meta {
  border-top: 1px solid var(--green-border);
  padding-top: 1rem;
  margin-bottom: 1.5rem;
}

/* linha "chave ........ valor" */
.lb-meta-row {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: .5rem;
}

.lb-meta-key {
  font-size: .75rem;
  letter-spacing: .1em;
  color: var(--cream-ghost);
  text-transform: uppercase;
  flex-shrink: 0;
}

.lb-meta-val {
  font-size: .8rem;
  letter-spacing: .06em;
  color: var(--cream-dim);
  text-align: right;
}

/* botão "ler texto →" (só aparece em fotos ligadas a um texto) */
.lb-text-link {
  display: block;
  font-family: var(--mono);
  font-size: .82rem;
  letter-spacing: .15em;
  text-transform: uppercase;
  color: #fffaf0; /* quase branco sobre vermelho: 5:1 */
  background: var(--ektar-red);
  padding: .8rem 1rem;
  text-decoration: none;
  text-align: center;
  transition: background .2s;
}
.lb-text-link:hover { background: var(--ektar-orange); }

.lb-close {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 40px;
  height: 40px;
  background: rgba(15,26,18,.8);
  border: 1px solid var(--green-border);
  color: var(--cream-dim);
  font-size: 1.2rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: all .2s;
  font-family: var(--mono);
}
.lb-close:hover { border-color: var(--cream); color: var(--cream); }

/* setas ← → no canto inferior esquerdo da foto */
.lb-nav {
  position: absolute;
  bottom: 12px;
  left: 12px;
  display: flex;
  gap: .4rem;
  z-index: 3;
}

.lb-nav-btn {
  width: 38px;
  height: 38px;
  background: rgba(30,46,34,.85);
  border: 1px solid var(--green-border);
  color: var(--cream);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--mono);
  font-size: .95rem;
  transition: all .2s;
}
.lb-nav-btn:hover { border-color: var(--cream-ghost); }

/* ══ RODAPÉ ═══════════════════════════════════════════════════════════════ */
footer {
  border-top: 1px solid var(--green-border);
  padding: 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.footer-logo { font-family: var(--mono); font-size: .85rem; letter-spacing: .15em; color: var(--cream); }
.footer-logo em { color: var(--ektar-red); font-style: normal; }
.footer-links { display: flex; gap: 1.5rem; }
.footer-links a { font-family: var(--mono); font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: var(--cream-ghost); text-decoration: none; transition: color .2s; }
.footer-links a:hover { color: var(--cream); }

/* ══ RESPONSIVO ═══════════════════════════════════════════════════════════
   ≤ 900px: lightbox em uma coluna (foto em cima, ficha embaixo).
   ≤ 768px: menu hambúrguer.
   ≤ 600px: tiras com rolagem horizontal e filtros em uma linha só. */
@media (max-width: 900px) {
  .lb-inner { grid-template-columns: 1fr; max-height: 95vh; overflow-y: auto; }
  .lb-photo { min-height: 50vw; }
  .lb-info { border-left: none; border-top: 1px solid var(--green-border); }
}

@media (max-width: 768px) {
  nav { padding: .8rem 1.2rem; }
  .nav-hamburger { display: flex; }

  /* menu vira painel suspenso logo abaixo do nav (49px = altura do nav mobile) */
  .nav-right {
    display: none;
    position: fixed;
    top: 49px; left: 0; right: 0;
    background: rgba(22,35,24,.98);
    flex-direction: column;
    align-items: flex-start;
    padding: 1.8rem 2rem;
    gap: 1.4rem;
    border-bottom: 1px solid #243a28;
    z-index: 102;
  }
  .nav-right.open { display: flex; }
  .nav-right a { font-size: 1rem; letter-spacing: .14em; }

  footer { flex-direction: column; gap: 1rem; text-align: center; }
}

@media (max-width: 600px) {
  .gallery-wrap { padding: 1rem 0; }
  .page-header { padding: 80px 1rem 0; }

  /* filtros: uma única linha que rola para o lado, em vez de dezenas de
     botões empilhados ocupando a primeira tela inteira. As margens
     negativas fazem a linha encostar nas bordas da tela. */
  .filter-bar {
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin: 0 -1rem;
    padding: 0 1rem 1.2rem;
  }
  .filter-bar::-webkit-scrollbar { display: none; }
  .filter-btn { flex-shrink: 0; }

  /* cada tira rola na horizontal. Grid com coluna max-content: a tira fica
     da largura dos frames e as faixas de perfuração acompanham (com flex
     elas parariam na largura da tela). */
  .roll-strip {
    display: grid;
    grid-template-columns: max-content;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .roll-strip::-webkit-scrollbar { display: none; }

  /* 2 frames por tira (ver getColumns no JS), cada um com 70% da tela —
     o segundo fica aparecendo pela metade, convidando a arrastar */
  .roll-frames {
    grid-template-columns: repeat(2, 70vw);
    gap: 4px;
    padding: 4px;
  }
  .frame-caption { font-size: .8rem; }
  .roll-perfs-h::before {
    background: repeating-linear-gradient(
      to right,
      transparent 0, transparent 5px,
      #000 5px, #000 13px,
      transparent 13px, transparent 18px
    );
  }
}
</style>
</head>
<body>

{# navActive marca o link "galeria" como página atual dentro do nav.njk #}
{% set navActive = "galeria" %}
{% include "nav.njk" %}

{# ── CABEÇALHO: perfurações, título, contagem e filtros ────────────────── #}
<div class="page-header">
  <div class="film-strip" id="perfs"></div>
  <div class="page-title-row">
    <span class="page-title">galeria fotográfica</span>
    <span class="page-count" id="count-label">— frames</span>
  </div>
  {# os demais botões são criados por buildFilterBar() #}
  <div class="filter-bar" id="filter-bar">
    <button class="filter-btn active" data-filter="all">todos</button>
  </div>
</div>

{# ── ROLO: preenchido por renderRoll() ─────────────────────────────────── #}
<div class="gallery-wrap">
  <div class="film-roll" id="roll"></div>
</div>

<footer>
  <span class="footer-logo">br<em>.</em>trombin</span>
  <div class="footer-links">
    <a href="{{ '/' | url }}">contact sheet</a>
    <a href="https://naocabe.substack.com" target="_blank" rel="noopener">Substack</a>
    <a href="https://www.instagram.com/brtrombin" target="_blank" rel="noopener">Instagram</a>
  </div>
</footer>

{# ── LIGHTBOX: um único painel, preenchido por openLightbox() ──────────── #}
<div class="lightbox" id="lightbox">
  <div class="lb-inner">
    <div class="lb-photo" id="lb-photo">
      <span class="lb-frame-n" id="lb-fn"></span>
      <div class="lb-stamp" id="lb-stamp"></div>
      <div class="lb-nav">
        <button class="lb-nav-btn" id="lb-prev" aria-label="foto anterior">&#8592;</button>
        <button class="lb-nav-btn" id="lb-next" aria-label="próxima foto">&#8594;</button>
      </div>
    </div>
    <div class="lb-info">
      <p class="lb-eyebrow" id="lb-eyebrow"></p>
      <h2 class="lb-title" id="lb-title"></h2>
      <p class="lb-caption" id="lb-caption"></p>
      <div class="lb-meta" id="lb-meta"></div>
      <a href="#" class="lb-text-link" id="lb-link">ler texto →</a>
    </div>
  </div>
  <button class="lb-close" id="lb-close" aria-label="fechar">&#215;</button>
</div>

<script>
// Base URL para paths de imagens e links (vazio em dev, /trombin no GitHub Pages)
const BASE = "{{ siteBase }}";

// ── Fonte 1: artigos (automático via Eleventy) ───────────────────────────────
// Cada texto com hero_image vira uma foto da galeria. O filtro "dump"
// converte o valor em JSON, com aspas e escapes corretos para o JS.
const fromArticles = [
  {% for article in collections.articles %}{% if article.data.hero_image %}
  {
    source: "article",
    img: {{ article.data.hero_image | dump | safe }},
    title: {{ article.data.title | dump | safe }},
    caption: {{ (article.data.lead or "") | dump | safe }},
    camera: {{ (article.data.camera or "") | dump | safe }},
    film: {{ (article.data.film or "") | dump | safe }},
    aperture: {{ (article.data.aperture or "") | dump | safe }},
    speed: {{ (article.data.speed or "") | dump | safe }},
    date: {{ article.date | dateStamp | dump | safe }},
    loc: {{ (article.data.location or "") | dump | safe }},
    themes: {{ (article.data.themes or []) | dump | safe }},
    collection: "",
    textLink: {{ article.url | dump | safe }}
  },
  {% endif %}{% endfor %}
];

// ── Fonte 2: fotos avulsas e coleções (_data/gallery.json) ──────────────────
// Esquema de cada entrada:
// { source: "photo"|"collection", img, title, caption, camera, film,
//   aperture, speed, date ("YYYY MM DD"), loc, themes: [], collection: "", textLink: null }
const fromGallery = {{ gallery | dump | safe }};

// ── Combinar e re-indexar ────────────────────────────────────────────────────
// Ordem visual: mais recente no topo (fromArticles já vem newest→oldest)
// Numeração: 001 = mais antigo, N = mais recente
const _all = [...fromArticles, ...fromGallery];
const photos = _all.map((p, i) => ({
  ...p,
  idx: String(_all.length - i).padStart(3, "0"),
  themes: p.themes || [],
  collection: p.collection || "",
  textLink: p.textLink || null
}));

// ── Estado ───────────────────────────────────────────────────────────────────
let current = 0;            // índice (dentro de "filtered") da foto aberta no lightbox
let filtered = [...photos]; // fotos visíveis com o filtro atual

const roll = document.getElementById('roll');
const lightbox = document.getElementById('lightbox');

// ── Utilitários ──────────────────────────────────────────────────────────────

// Frames por tira: 2 no celular, 4 no resto (acompanha o @media de 600px do CSS)
function getColumns() { return window.innerWidth <= 600 ? 2 : 4; }

// Divide um array em grupos de "size" itens
function chunk(arr, size) {
  const out = [];
  for (let i = 0; i < arr.length; i += size) out.push(arr.slice(i, i + size));
  return out;
}

// Abreviação de câmera: "Fujifilm X100F" → "X100F", "iPhone 15" → "iPhone"
function shortCamera(cam) {
  if (!cam) return '';
  if (cam.toLowerCase().includes('iphone')) return 'iPhone';
  return cam.split(' ').pop();
}

// Categorias de um frame para filtrar: ["theme:viagem", "col:nome-da-coleção", …]
function buildCat(p) {
  const cats = (p.themes || []).map(t => 'theme:' + t);
  if (p.collection) cats.push('col:' + p.collection);
  return cats;
}

// Fotos que passam em um filtro ("all", "theme:…" ou "col:…")
function applyFilter(f) {
  return f === 'all' ? [...photos] : photos.filter(p => buildCat(p).includes(f));
}

// ── Filtros dinâmicos por tema ───────────────────────────────────────────────
// Cria um botão para cada tema e coleção que aparece em alguma foto.
function buildFilterBar() {
  const bar = document.getElementById('filter-bar');
  const themeCounts = new Map();  // tema → quantas fotos
  const collections = new Map();  // coleção → quantas fotos

  photos.forEach(p => {
    (p.themes || []).forEach(t => themeCounts.set(t, (themeCounts.get(t) || 0) + 1));
    if (p.collection) collections.set(p.collection, (collections.get(p.collection) || 0) + 1);
  });

  // ordena por frequência, mostra todos os temas que aparecem em pelo menos 1 foto
  const sortedThemes = [...themeCounts.entries()].sort((a, b) => b[1] - a[1]);

  bar.innerHTML = '<button class="filter-btn active" data-filter="all">todos</button>';
  sortedThemes.forEach(([theme]) => {
    bar.innerHTML += `<button class="filter-btn" data-filter="theme:${theme}">${theme}</button>`;
  });
  collections.forEach((_, col) => {
    bar.innerHTML += `<button class="filter-btn" data-filter="col:${col}">${col}</button>`;
  });

  // clique: marca o botão como ativo e redesenha o rolo só com as fotos do filtro
  bar.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      bar.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filtered = applyFilter(btn.dataset.filter);
      renderRoll(filtered);
    });
  });
}

// ── Renderizar rolo ──────────────────────────────────────────────────────────
// Apaga o rolo e redesenha "list" em tiras de N frames (N = getColumns()).
let renderedColumns = 0; // colunas usadas no último desenho (ver listener de resize)

function renderRoll(list) {
  roll.innerHTML = '';
  const cols = getColumns();
  renderedColumns = cols;
  const rows = chunk(list, cols);

  rows.forEach(row => {
    const strip = document.createElement('div');
    strip.className = 'roll-strip';

    // faixas de perfuração acima e abaixo dos frames
    const topPerfs = document.createElement('div');
    topPerfs.className = 'roll-perfs-h';
    const botPerfs = document.createElement('div');
    botPerfs.className = 'roll-perfs-h';

    const frames = document.createElement('div');
    frames.className = 'roll-frames';

    row.forEach(p => {
      const globalIdx = list.indexOf(p); // posição na lista filtrada, usada pelo lightbox
      const shortDate = p.date ? p.date.slice(0, 7) : ''; // "2025 02 10" → "2025 02"
      const camShort = shortCamera(p.camera);
      const metaLine = [shortDate, camShort].filter(Boolean).join(' · ');
      // selos "coleção" / "texto": ainda não têm CSS, então hoje ficam ocultos
      // (caem fora da área visível do frame)
      const collectionBadge = p.collection
        ? `<span class="has-text-badge">${p.collection}</span>` : '';
      const textBadge = (!p.collection && p.source === 'article')
        ? '<span class="has-text-badge">texto</span>' : '';

      // card wrapper
      const card = document.createElement('div');
      card.className = 'frame-card';

      // frame (imagem)
      const cell = document.createElement('div');
      cell.className = 'frame-cell';
      cell.innerHTML = `
        <img src="${BASE}${p.img}" alt="${p.title}" loading="lazy">
        <span class="frame-idx">${p.idx}</span>
        ${metaLine ? `<div class="frame-meta">${metaLine}</div>` : ''}
        ${collectionBadge || textBadge}
      `;
      cell.addEventListener('click', () => openLightbox(globalIdx, list));

      // legenda sempre visível abaixo
      const caption = document.createElement('div');
      caption.className = 'frame-caption';
      caption.textContent = p.title;

      card.appendChild(cell);
      card.appendChild(caption);
      frames.appendChild(card);
    });

    strip.appendChild(topPerfs);
    strip.appendChild(frames);
    strip.appendChild(botPerfs);
    roll.appendChild(strip);
  });

  document.getElementById('count-label').textContent = list.length + ' frames';
}

// ── Lightbox ─────────────────────────────────────────────────────────────────
// Abre a foto de índice i da lista e preenche todos os campos do painel.
function openLightbox(i, list) {
  current = i;
  const p = list[i];

  // troca a imagem: remove a anterior e insere a nova como primeiro filho
  const lbPhoto = document.getElementById('lb-photo');
  const existingImg = lbPhoto.querySelector('img');
  if (existingImg) existingImg.remove();
  const img = document.createElement('img');
  img.src = BASE + p.img;
  img.alt = p.title;
  lbPhoto.insertBefore(img, lbPhoto.firstChild);

  document.getElementById('lb-fn').textContent = p.idx;

  // carimbo: local curto (antes do " · ") / data / abertura + velocidade
  const stampParts = [p.loc ? p.loc.replace(/\s*·\s*.*/, '').trim() : '', p.date];
  if (p.aperture || p.speed) stampParts.push([p.aperture, p.speed].filter(Boolean).join('  '));
  document.getElementById('lb-stamp').innerHTML = stampParts.filter(Boolean).join('<br>');

  // "frame 012 · nome da coleção" ou "frame 012 · filme"
  const eyebrowParts = [`frame ${p.idx}`];
  if (p.collection) eyebrowParts.push(p.collection);
  else if (p.film) eyebrowParts.push(p.film);
  document.getElementById('lb-eyebrow').textContent = eyebrowParts.join(' · ');

  document.getElementById('lb-title').textContent = p.title;
  document.getElementById('lb-caption').textContent = p.caption;

  // ficha técnica: só entram as linhas que têm dado
  let metaHTML = '';
  if (p.camera)   metaHTML += `<div class="lb-meta-row"><span class="lb-meta-key">câmera</span><span class="lb-meta-val">${p.camera}</span></div>`;
  if (p.film)     metaHTML += `<div class="lb-meta-row"><span class="lb-meta-key">filme</span><span class="lb-meta-val">${p.film}</span></div>`;
  if (p.aperture) metaHTML += `<div class="lb-meta-row"><span class="lb-meta-key">abertura</span><span class="lb-meta-val">${p.aperture}</span></div>`;
  if (p.speed)    metaHTML += `<div class="lb-meta-row"><span class="lb-meta-key">veloc.</span><span class="lb-meta-val">${p.speed}</span></div>`;
  if (p.loc)      metaHTML += `<div class="lb-meta-row"><span class="lb-meta-key">local</span><span class="lb-meta-val">${p.loc}</span></div>`;
  if (p.date)     metaHTML += `<div class="lb-meta-row"><span class="lb-meta-key">data</span><span class="lb-meta-val">${p.date}</span></div>`;
  document.getElementById('lb-meta').innerHTML = metaHTML;

  // botão "ler texto": só para fotos que vieram de um artigo
  const link = document.getElementById('lb-link');
  if (p.textLink) {
    link.href = BASE + p.textLink;
    link.style.display = 'block';
  } else {
    link.style.display = 'none';
  }

  lightbox.classList.add('open');
  document.body.style.overflow = 'hidden'; // trava a rolagem da página atrás

  // setas: reatribuídas a cada abertura para navegar dentro da lista atual
  document.getElementById('lb-prev').onclick = (e) => {
    e.stopPropagation();
    if (current > 0) openLightbox(current - 1, list);
  };
  document.getElementById('lb-next').onclick = (e) => {
    e.stopPropagation();
    if (current < list.length - 1) openLightbox(current + 1, list);
  };
}

function closeLightbox() {
  lightbox.classList.remove('open');
  document.body.style.overflow = '';
}

// Fechar: botão ×, clique no fundo escuro ou tecla Esc. Setas do teclado navegam.
document.getElementById('lb-close').addEventListener('click', closeLightbox);
lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
document.addEventListener('keydown', (e) => {
  if (!lightbox.classList.contains('open')) return;
  if (e.key === 'Escape') closeLightbox();
  if (e.key === 'ArrowLeft' && current > 0) openLightbox(current - 1, filtered);
  if (e.key === 'ArrowRight' && current < filtered.length - 1) openLightbox(current + 1, filtered);
});

// ── Perfurações no header ────────────────────────────────────────────────────
// Preenche a faixa com furos suficientes para a largura da janela (30px por furo).
function makePerfs() {
  const el = document.getElementById('perfs');
  if (!el) return;
  const n = Math.ceil(window.innerWidth / 30) + 2;
  el.innerHTML = Array(n).fill('<div class="perf"></div>').join('');
}
makePerfs();

// Ao redimensionar: refaz as perfurações e, só se o número de colunas mudou
// (ex.: girar o celular), redesenha o rolo. Sem essa checagem o rolo seria
// redesenhado a cada rolagem no celular — a barra de endereço que aparece e
// some dispara "resize" — e as tiras voltariam ao início.
window.addEventListener('resize', () => {
  makePerfs();
  if (getColumns() !== renderedColumns) renderRoll(filtered);
});

// ── Init ─────────────────────────────────────────────────────────────────────
buildFilterBar();

// Aplica filtro via URL param ?theme=nome (vindo dos links de temas dos artigos)
const _urlTheme = new URLSearchParams(window.location.search).get('theme');
if (_urlTheme) {
  filtered = photos.filter(p => (p.themes || []).includes(_urlTheme));
  document.querySelectorAll('.filter-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.filter === 'theme:' + _urlTheme);
  });
  renderRoll(filtered);
  // no celular a barra de filtros rola para o lado: traz o filtro ativo para a vista
  const activeBtn = document.querySelector('.filter-btn.active');
  if (activeBtn) activeBtn.scrollIntoView({ block: 'nearest', inline: 'center' });
} else {
  renderRoll(photos);
}

// ── Menu hambúrguer (mobile) ─────────────────────────────────────────────────
(function() {
  var toggle = document.getElementById("nav-toggle");
  var menu   = document.getElementById("nav-menu");
  if (!toggle || !menu) return;

  // abre/fecha ao tocar no botão
  toggle.addEventListener("click", function() {
    var open = menu.classList.toggle("open");
    toggle.classList.toggle("open", open);
    toggle.setAttribute("aria-expanded", String(open));
  });

  // fecha ao tocar fora do menu
  document.addEventListener("click", function(e) {
    if (!menu.contains(e.target) && !toggle.contains(e.target)) {
      menu.classList.remove("open");
      toggle.classList.remove("open");
      toggle.setAttribute("aria-expanded", "false");
    }
  });

  // fecha ao escolher um link
  menu.querySelectorAll("a").forEach(function(a) {
    a.addEventListener("click", function() {
      menu.classList.remove("open");
      toggle.classList.remove("open");
      toggle.setAttribute("aria-expanded", "false");
    });
  });
})();
</script>
</body>
</html>
