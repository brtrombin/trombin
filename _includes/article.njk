{#
  Layout de artigo (texto) — usado por todo .md em /articles que não declara outro layout.

  Estrutura da página:
    1. nav fixo no topo (logo · voltar ao contact sheet · links)
    2. capa em formato de tira de filme (perfurações + foto + carimbo de data)
    3. duas colunas: texto à esquerda, ficha técnica (sidebar) à direita
    4. navegação anterior/próximo e rodapé

  Front matter esperado no .md:
    title, date, lead, type, hero_image | hero_gradient, location, camera, film,
    aperture, speed, author_note, themes[], substack_url
  Injetado pelo .eleventy.js (collection "articles"):
    frameNumber, prevArticle, nextArticle
#}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — br.trombin</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
<style>
/* ══ TOKENS ═══════════════════════════════════════════════════════════════
   Paleta e fontes. As cores "-text" são versões mais claras dos acentos,
   usadas só em texto pequeno: o vermelho/laranja Ektar puro não atinge
   contraste 4.5:1 (WCAG AA) sobre o fundo verde-escuro. */
:root {
  --bg: #1e2e22;
  --bg-dark: #162318;
  --bg-deeper: #0f1a12;
  --green-mid: #243a28;
  --green-border: #2e4a32;

  --ektar-red: #c8341a;          /* bordas, capitular, detalhes decorativos */
  --ektar-red-text: #f07050;     /* rótulos em vermelho (contraste 4.9:1) */
  --ektar-orange: #d4621e;
  --ektar-orange-text: #e88a4a;  /* subtítulos em laranja (contraste 5.6:1) */
  --ektar-amber: #e8a830;

  --cream: #f0e8d0;              /* títulos */
  --cream-text: #d8ccb0;         /* corpo do texto (contraste 9:1) */
  --cream-dim: #b8a880;          /* texto secundário (6:1) */
  --cream-ghost: #a09070;        /* texto terciário — mínimo legível (4.6:1) */

  --mono: 'Share Tech Mono', monospace;
  --serif: 'Playfair Display', serif;
}

/* ══ RESET + BASE ═════════════════════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--cream);
  font-family: var(--serif);
  min-height: 100vh;
  overflow-x: hidden;
}

/* Grão de filme: ruído SVG fixo por cima de tudo, sem capturar cliques */
body::after {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 999;
  pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  opacity: .05;
  mix-blend-mode: screen;
}

/* ══ NAV PRINCIPAL ════════════════════════════════════════════════════════
   :not([class]) é obrigatório: sem ele a regra também fixaria no topo o
   <nav class="article-nav"> (anterior/próximo) do fim do texto. */
nav:not([class]) {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: .85rem 2rem;
  background: rgba(30,46,34,.94);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--green-border);
}

.logo {
  font-family: var(--mono);
  font-size: .9rem;
  letter-spacing: .2em;
  color: var(--cream);
  text-decoration: none;
  flex-shrink: 0;
}
.logo em { color: var(--ektar-red); font-style: normal; }

/* centro do nav: "← contact sheet" + número do frame (some em telas menores) */
.nav-center {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.nav-back {
  font-family: var(--mono);
  font-size: .8rem;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--cream-dim);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: .4rem;
  transition: color .2s;
}
.nav-back:hover { color: var(--cream); }
.nav-back::before { content: '←'; font-size: .85rem; }

.nav-frame {
  font-family: var(--mono);
  font-size: .75rem;
  letter-spacing: .12em;
  color: var(--ektar-amber);
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 1.4rem;
}
.nav-right a {
  font-family: var(--mono);
  font-size: .8rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--cream-dim);
  text-decoration: none;
  transition: color .2s;
}
.nav-right a:hover { color: var(--cream); }

/* links externos (Substack / Instagram) em formato de etiqueta */
.nav-pill {
  border: 1px solid var(--ektar-red);
  padding: .22rem .7rem;
  color: var(--ektar-red-text) !important;
}

/* botão hambúrguer — só aparece no breakpoint mobile (ver @media) */
.nav-hamburger {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  /* padding grande + margem negativa: área de toque de ~44px sem aumentar o nav */
  padding: 14px 11px;
  margin: -10px -7px;
  z-index: 101;
}
.nav-hamburger span {
  width: 22px; height: 2px;
  background: var(--cream);
  display: block;
  transition: transform .25s, opacity .2s;
}
/* estado aberto: as três barras viram um X */
.nav-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.nav-hamburger.open span:nth-child(2) { opacity: 0; }
.nav-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* ══ CAPA (tira de filme) ═════════════════════════════════════════════════ */
.article-hero {
  padding-top: 52px; /* altura do nav fixo */
  position: relative;
}

/* faixas de perfuração acima e abaixo da foto; os furos (.perf) são
   gerados por JS conforme a largura da janela */
.hero-film-strip {
  background: #100c07;
  height: 28px;
  display: flex;
  align-items: center;
  gap: 0;
  padding: 0 6px;
  border-bottom: 2px solid #0d0a05;
  overflow: hidden;
}

.perf {
  width: 14px;
  height: 10px;
  background: #030201;
  border: 1px solid #1a1409;
  border-radius: 2px;
  margin-right: 18px;
  flex-shrink: 0;
}

.hero-img-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 21/9; /* panorâmico no desktop; vira 4/3 no mobile */
  overflow: hidden;
  background: var(--bg-deeper);
  border-top: 3px solid var(--bg-deeper);
  border-bottom: 3px solid var(--bg-deeper);
}

/* placeholder em degradê quando o artigo não tem hero_image */
.hero-img-wrap .ph {
  width: 100%;
  height: 100%;
}

.hero-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: contrast(1.1) saturate(1.2);
  display: block;
}

/* carimbo laranja estilo "data back" de câmera analógica */
.hero-stamp {
  position: absolute;
  bottom: 14px;
  right: 18px;
  font-family: var(--mono);
  font-size: clamp(.8rem, 1.1vw, .95rem);
  color: #ff7800;
  letter-spacing: .14em;
  text-shadow: 0 0 6px rgba(255,120,0,.9), 0 0 14px rgba(255,80,0,.5);
  line-height: 1.6;
  text-align: right;
}

/* número do frame no canto superior esquerdo da capa */
.hero-frame-n {
  position: absolute;
  top: 10px;
  left: 14px;
  font-family: var(--mono);
  font-size: .75rem;
  color: #ff9a2e;
  letter-spacing: .12em;
  text-shadow: 0 0 5px rgba(0,0,0,.9);
}

.hero-film-strip-bot {
  background: var(--bg-deeper);
  height: 28px;
  display: flex;
  align-items: center;
  padding: 0 6px;
  overflow: hidden;
}

/* ══ ARTIGO — grade de duas colunas ═══════════════════════════════════════
   minmax(0, 1fr) impede que conteúdo largo (imagem, palavra longa)
   alargue a coluna do texto além da tela. */
.article-wrap {
  max-width: 1140px;
  margin: 0 auto;
  padding: 4rem 2rem 6rem;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 250px;
  gap: 4rem;
  align-items: start;
}

.article-header {
  margin-bottom: 3rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--green-border);
}

/* linha "leitura · mês ano" acima do título */
.article-eyebrow {
  font-family: var(--mono);
  font-size: .78rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--ektar-red-text);
  margin-bottom: 1.2rem;
}

.article-title {
  font-family: var(--serif);
  font-size: clamp(2rem, 4vw, 3.4rem);
  line-height: 1.1;
  font-style: italic;
  font-weight: 400;
  color: var(--cream);
  margin-bottom: 1.2rem;
}

.article-lead {
  font-family: var(--serif);
  font-size: 1.2rem;
  line-height: 1.7;
  color: var(--cream-dim);
  font-style: italic;
  max-width: 58ch;
}

/* ── Corpo do texto (HTML gerado a partir do markdown) ────────────────── */

/* ## do markdown — intertítulo em mono, laranja */
.article-body h2 {
  font-family: var(--mono);
  font-size: .9rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  font-weight: 400;
  color: var(--ektar-orange-text);
  line-height: 1.5;
  margin-top: 3.5rem;
  margin-bottom: 1rem;
  max-width: 62ch;
}

.article-body h3 {
  font-family: var(--mono);
  font-size: .85rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--ektar-red-text);
  line-height: 1.5;
  margin-top: 3rem;
  margin-bottom: .9rem;
  max-width: 62ch;
}

/* parágrafo: 18px com entrelinha generosa — é o texto principal do site */
.article-body p,
.article-body li {
  font-family: var(--serif);
  font-size: 1.125rem;
  line-height: 1.8;
  color: var(--cream-text);
  max-width: 62ch;
}
.article-body p { margin-bottom: 1.6rem; }

.article-body strong { color: var(--cream); }

.article-body a {
  color: var(--ektar-orange-text);
  text-underline-offset: 3px;
}
.article-body a:hover { color: var(--cream); }

.article-body ul,
.article-body ol {
  margin: 0 0 1.6rem 1.4rem;
}
.article-body li { margin-bottom: .5rem; }

.article-body blockquote {
  margin: 2rem 0;
  padding: .2rem 0 .2rem 1.4rem;
  border-left: 3px solid var(--ektar-red);
  max-width: 62ch;
}
.article-body blockquote p { font-style: italic; color: var(--cream); }
.article-body blockquote p:last-child { margin-bottom: 0; }

/* --- do markdown — separador de seção */
.article-body hr {
  border: none;
  border-top: 1px solid var(--green-border);
  margin: 3rem 0;
  max-width: 62ch;
}

/* imagens vindas do markdown (ex.: importadas do Substack) nunca passam
   da largura da coluna */
.article-body img {
  max-width: 100%;
  height: auto;
  display: block;
}

/* capitular vermelha na primeira letra do texto */
.article-body p:first-child::first-letter {
  font-size: 3.6rem;
  line-height: .8;
  float: left;
  margin: .05em .12em -.05em 0;
  color: var(--ektar-red-text);
  font-style: italic;
  font-weight: 700;
}

/* ── Foto intercalada (bloco HTML opcional dentro do .md) ───────────────
   <div class="inline-photo [wide]">
     <div class="inline-photo-frame"> <img> + .inline-photo-frame-n + .inline-photo-stamp </div>
     <p class="photo-caption">…</p>
   </div> */
.inline-photo {
  margin: 2.5rem 0;
  position: relative;
}

.inline-photo-frame {
  background: var(--bg-deeper);
  padding: 4px;
  border: 2px solid var(--bg-deeper);
  position: relative;
}

.inline-photo-frame img {
  width: 100%;
  aspect-ratio: 4/3;
  object-fit: cover;
  display: block;
  filter: contrast(1.08) saturate(1.15);
}

.inline-photo-stamp {
  position: absolute;
  bottom: 10px;
  right: 10px;
  font-family: var(--mono);
  font-size: .72rem;
  color: #ff8c00;
  letter-spacing: .1em;
  text-shadow: 0 0 6px rgba(255,140,0,.5), 0 0 4px rgba(0,0,0,.8);
  line-height: 1.5;
  text-align: right;
}

.inline-photo-frame-n {
  position: absolute;
  top: 8px;
  left: 10px;
  font-family: var(--mono);
  font-size: .72rem;
  color: #ff9a2e;
  letter-spacing: .1em;
  text-shadow: 0 0 5px rgba(0,0,0,.9);
}

/* .photo-caption é um <p> dentro de .article-body, por isso o seletor
   composto: precisa vencer a regra ".article-body p" */
.article-body .photo-caption {
  margin-top: .8rem;
  margin-bottom: 0;
  font-family: var(--mono);
  font-size: .75rem;
  line-height: 1.5;
  letter-spacing: .1em;
  color: var(--cream-ghost);
  text-transform: uppercase;
  padding-left: 4px;
}

/* variante panorâmica: sangra além das margens laterais da coluna */
.inline-photo.wide {
  margin-left: -2rem;
  margin-right: -2rem;
}

/* ══ SIDEBAR (ficha técnica) ══════════════════════════════════════════════
   Acompanha a rolagem no desktop (sticky); no mobile vai para baixo do texto. */
.article-sidebar {
  position: sticky;
  top: 80px;
}

.sidebar-block {
  margin-bottom: 2.5rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--green-border);
}

.sidebar-block:last-child { border-bottom: none; }

.sidebar-label {
  font-family: var(--mono);
  font-size: .75rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--ektar-red-text);
  margin-bottom: 1rem;
}

/* linha "chave ........ valor" */
.sidebar-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1rem;
  margin-bottom: .6rem;
}

.sidebar-meta-key {
  font-family: var(--mono);
  font-size: .75rem;
  letter-spacing: .1em;
  color: var(--cream-ghost);
  text-transform: uppercase;
  flex-shrink: 0;
}

.sidebar-meta-val {
  font-family: var(--mono);
  font-size: .8rem;
  line-height: 1.5;
  letter-spacing: .06em;
  color: var(--cream-dim);
  text-align: right;
}

.sidebar-note {
  font-family: var(--serif);
  font-size: .95rem;
  line-height: 1.7;
  color: var(--cream-dim);
  font-style: italic;
}

.sidebar-tags {
  display: flex;
  flex-wrap: wrap;
  gap: .5rem;
}

/* etiqueta de tema — leva para a galeria já filtrada (?theme=…) */
.tag {
  font-family: var(--mono);
  font-size: .75rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--cream-dim);
  border: 1px solid var(--green-border);
  padding: .32rem .7rem;
  text-decoration: none;
  cursor: pointer;
  transition: color .2s, border-color .2s;
}
.tag:hover {
  color: var(--cream);
  border-color: var(--cream-dim);
}

/* o primeiro tema do artigo ganha destaque em vermelho */
.tag.red {
  color: var(--ektar-red-text);
  border-color: var(--ektar-red);
}
.tag.red:hover {
  color: var(--cream);
  border-color: var(--cream-dim);
}

/* link "também em: Substack" */
.sidebar-link {
  font-family: var(--mono);
  font-size: .75rem;
  letter-spacing: .1em;
  color: var(--ektar-red-text);
  text-decoration: none;
  text-transform: uppercase;
}
.sidebar-link:hover { color: var(--cream); }

/* ══ NAVEGAÇÃO ENTRE TEXTOS (anterior / próximo) ══════════════════════════ */
.article-nav {
  margin-top: 4rem;
  padding-top: 2rem;
  border-top: 1px solid var(--green-border);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.article-nav-link {
  text-decoration: none;
  padding: 1rem;
  border: 1px solid var(--green-border);
  transition: border-color .2s, background .2s;
  display: block;
}

.article-nav-link:hover {
  border-color: var(--cream-ghost);
  background: rgba(255,255,255,.02);
}

.article-nav-link.next { text-align: right; }

.anl-dir {
  font-family: var(--mono);
  font-size: .72rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--ektar-red-text);
  margin-bottom: .4rem;
}

.anl-title {
  font-family: var(--serif);
  font-size: 1rem;
  font-style: italic;
  color: var(--cream-dim);
  line-height: 1.35;
}

/* ══ RODAPÉ ═══════════════════════════════════════════════════════════════ */
footer {
  border-top: 1px solid var(--green-border);
  padding: 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer-logo {
  font-family: var(--mono);
  font-size: .85rem;
  letter-spacing: .15em;
  color: var(--cream);
}
.footer-logo em { color: var(--ektar-red); font-style: normal; }

.footer-links { display: flex; gap: 1.5rem; }
.footer-links a {
  font-family: var(--mono);
  font-size: .75rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--cream-ghost);
  text-decoration: none;
  transition: color .2s;
}
.footer-links a:hover { color: var(--cream); }

/* ══ RESPONSIVO ═══════════════════════════════════════════════════════════
   ≤ 1000px: o nav perde o bloco central (não cabe ao lado dos links).
   ≤ 800px : menu hambúrguer, uma coluna só, sidebar abaixo do texto. */
@media (max-width: 1000px) {
  .nav-center { display: none; }
}

@media (max-width: 800px) {
  nav:not([class]) { padding: .8rem 1.2rem; }
  .nav-hamburger { display: flex; }

  /* menu vira painel suspenso logo abaixo do nav (49px = altura do nav mobile) */
  .nav-right {
    display: none;
    position: fixed;
    top: 49px; left: 0; right: 0;
    background: rgba(22,35,24,.98);
    flex-direction: column;
    align-items: flex-start;
    padding: 1.8rem 2rem;
    gap: 1.4rem;
    border-bottom: 1px solid #243a28;
    z-index: 102;
  }
  .nav-right.open { display: flex; }
  .nav-right a { font-size: 1rem; letter-spacing: .14em; }

  .article-wrap {
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    padding: 2.5rem 1.2rem 4rem;
  }
  .article-sidebar { position: static; }
  .hero-img-wrap { aspect-ratio: 4/3; }
  .inline-photo.wide { margin-left: -1.2rem; margin-right: -1.2rem; }
  footer { flex-direction: column; gap: 1rem; text-align: center; }
}

/* telas muito estreitas: anterior/próximo empilhados */
@media (max-width: 420px) {
  .article-nav { grid-template-columns: 1fr; }
  .article-nav-link.next { text-align: left; }
}
</style>
</head>
<body>

{# ── NAV ─────────────────────────────────────────────────────────────────
   Versão própria do artigo (não usa nav.njk) por causa do bloco central
   com "voltar" e número do frame. #}
<nav aria-label="Navegação principal">
  <a href="{{ '/' | url }}" class="logo" aria-label="br.trombin — página inicial">br<em>.</em>trombin</a>
  <div class="nav-center">
    <a href="{{ '/' | url }}" class="nav-back">contact sheet</a>
    <span class="nav-frame">frame {{ frameNumber }} / 99exp</span>
  </div>
  <div class="nav-right" id="nav-menu">
    <a href="{{ '/sobre/' | url }}">sobre</a>
    <a href="{{ '/galeria.html' | url }}">galeria</a>
    <a href="https://naocabe.substack.com" target="_blank" rel="noopener" class="nav-pill">Substack</a>
    <a href="https://www.instagram.com/brtrombin" target="_blank" rel="noopener" class="nav-pill">Instagram</a>
  </div>
  <button class="nav-hamburger" id="nav-toggle" aria-label="abrir menu" aria-expanded="false" aria-controls="nav-menu">
    <span></span><span></span><span></span>
  </button>
</nav>

{# ── CAPA ────────────────────────────────────────────────────────────────
   Foto de capa (ou degradê, se não houver hero_image) entre duas faixas
   de perfuração preenchidas por JS. #}
<div class="article-hero">
  <div class="hero-film-strip" id="perfs-top"></div>
  <div class="hero-img-wrap">
    {% if hero_image %}
    <img src="{{ hero_image | url }}" alt="{{ title }}">
    {% else %}
    <div class="ph" style="background:{{ hero_gradient | default('linear-gradient(160deg,#1a3a5c 0%,#2e6a9e 30%,#6a8a5a 60%,#c8621e 85%,#c8341a 100%)') }}"></div>
    {% endif %}
    <span class="hero-frame-n">{{ frameNumber }}</span>
    {# carimbo: local / data / abertura + velocidade — cada linha só aparece se o dado existir #}
    <div class="hero-stamp">
      {% if location %}{{ location }}<br>{% endif %}
      {{ date | dateStamp }}{% if aperture or speed %}<br>{{ aperture }}{% if aperture and speed %}&nbsp;&nbsp;{% endif %}{{ speed }}{% endif %}
    </div>
  </div>
  <div class="hero-film-strip-bot" id="perfs-bot"></div>
</div>

<div class="article-wrap">

  {# ── COLUNA PRINCIPAL: cabeçalho, texto e anterior/próximo ───────────── #}
  <main class="article-main">

    <header class="article-header">
      <p class="article-eyebrow">{{ type | default("leitura") }} &middot; {{ date | dateLong }}</p>
      <h1 class="article-title">{{ title }}</h1>
      {% if lead %}
      <p class="article-lead">{{ lead }}</p>
      {% endif %}
    </header>

    {# conteúdo do .md já convertido em HTML #}
    <div class="article-body">
      {{ content | safe }}
    </div>

    {# prev = texto mais antigo, next = mais recente (definidos no .eleventy.js).
       O <div> vazio mantém "próximo" na coluna da direita quando não há anterior. #}
    <nav class="article-nav" aria-label="Outros textos">
      {% if prevArticle %}
      <a href="{{ prevArticle.url }}" class="article-nav-link prev">
        <p class="anl-dir">← anterior</p>
        <p class="anl-title">{{ prevArticle.data.title }}</p>
      </a>
      {% else %}
      <div></div>
      {% endif %}
      {% if nextArticle %}
      <a href="{{ nextArticle.url }}" class="article-nav-link next">
        <p class="anl-dir">próximo →</p>
        <p class="anl-title">{{ nextArticle.data.title }}</p>
      </a>
      {% endif %}
    </nav>

  </main>

  {# ── SIDEBAR: ficha técnica da foto, nota, temas e link do Substack ──── #}
  <aside class="article-sidebar">

    {# exposição — cada linha só aparece se o campo existir no front matter #}
    <div class="sidebar-block">
      <p class="sidebar-label">exposição</p>
      {% if camera %}
      <div class="sidebar-meta-row">
        <span class="sidebar-meta-key">câmera</span>
        <span class="sidebar-meta-val">{{ camera }}</span>
      </div>
      {% endif %}
      {% if film %}
      <div class="sidebar-meta-row">
        <span class="sidebar-meta-key">filme</span>
        <span class="sidebar-meta-val">{{ film }}</span>
      </div>
      {% endif %}
      {% if aperture %}
      <div class="sidebar-meta-row">
        <span class="sidebar-meta-key">abertura</span>
        <span class="sidebar-meta-val">{{ aperture }}</span>
      </div>
      {% endif %}
      {% if speed %}
      <div class="sidebar-meta-row">
        <span class="sidebar-meta-key">velocidade</span>
        <span class="sidebar-meta-val">{{ speed }}</span>
      </div>
      {% endif %}
      {% if location %}
      <div class="sidebar-meta-row">
        <span class="sidebar-meta-key">local</span>
        <span class="sidebar-meta-val">{{ location }}</span>
      </div>
      {% endif %}
      <div class="sidebar-meta-row">
        <span class="sidebar-meta-key">data</span>
        <span class="sidebar-meta-val">{{ date | dateFormattedPT }}</span>
      </div>
    </div>

    {% if author_note %}
    <div class="sidebar-block">
      <p class="sidebar-label">nota do autor</p>
      <p class="sidebar-note">{{ author_note }}</p>
    </div>
    {% endif %}

    {# temas — cada etiqueta abre a galeria filtrada por aquele tema #}
    {% if themes %}
    <div class="sidebar-block">
      <p class="sidebar-label">temas</p>
      <div class="sidebar-tags">
        {% for theme in themes %}
        <a href="{{ '/galeria.html' | url }}?theme={{ theme }}" class="tag{% if loop.first %} red{% endif %}">{{ theme }}</a>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if substack_url %}
    <div class="sidebar-block">
      <p class="sidebar-label">também em</p>
      <div class="sidebar-meta-row">
        <a href="{{ substack_url }}" target="_blank" rel="noopener" class="sidebar-link">Não Cabia · Substack ↗</a>
      </div>
    </div>
    {% endif %}

  </aside>
</div>

<footer>
  <span class="footer-logo">br<em>.</em>trombin</span>
  <div class="footer-links">
    <a href="{{ '/' | url }}">contact sheet</a>
    <a href="https://naocabe.substack.com" target="_blank" rel="noopener">Substack</a>
    <a href="https://www.instagram.com/brtrombin" target="_blank" rel="noopener">Instagram</a>
  </div>
</footer>

<script>
// ── Perfurações da tira de filme ─────────────────────────────────────────
// Preenche a faixa com furos suficientes para a largura atual da janela
// (cada furo ocupa 32px: 14 de largura + 18 de margem).
function makePerfs(id) {
  const el = document.getElementById(id);
  if (!el) return;
  const n = Math.ceil(window.innerWidth / 32) + 2;
  el.innerHTML = Array(n).fill('<div class="perf"></div>').join('');
}
makePerfs('perfs-top');
makePerfs('perfs-bot');
window.addEventListener('resize', () => { makePerfs('perfs-top'); makePerfs('perfs-bot'); });

// ── Menu hambúrguer (mobile) ─────────────────────────────────────────────
(function() {
  var toggle = document.getElementById("nav-toggle");
  var menu   = document.getElementById("nav-menu");
  if (!toggle || !menu) return;

  // abre/fecha ao tocar no botão
  toggle.addEventListener("click", function() {
    var open = menu.classList.toggle("open");
    toggle.classList.toggle("open", open);
    toggle.setAttribute("aria-expanded", String(open));
  });

  // fecha ao tocar fora do menu
  document.addEventListener("click", function(e) {
    if (!menu.contains(e.target) && !toggle.contains(e.target)) {
      menu.classList.remove("open");
      toggle.classList.remove("open");
      toggle.setAttribute("aria-expanded", "false");
    }
  });

  // fecha ao escolher um link
  menu.querySelectorAll("a").forEach(function(a) {
    a.addEventListener("click", function() {
      menu.classList.remove("open");
      toggle.classList.remove("open");
      toggle.setAttribute("aria-expanded", "false");
    });
  });
})();
</script>
</body>
</html>
