{#
  Layout de ensaio fotográfico — usado pelos .md com "layout: ensaio.njk".

  Estrutura da página:
    1. nav fixo no topo (igual ao do artigo)
    2. capa em tira de filme
    3. cabeçalho (título, lead, câmera/filme/local)
    4. grade de fotos — cada foto abre no lightbox
    5. navegação anterior/próximo e rodapé

  Front matter esperado no .md:
    title, date, lead, hero_image, location, camera, film,
    images: [ { src, caption }, … ]
  Injetado pelo .eleventy.js (collection "articles"):
    frameNumber, prevArticle, nextArticle
#}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — br.trombin</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
<style>
/* ══ TOKENS ═══════════════════════════════════════════════════════════════
   Mesma paleta do article.njk. As cores "-text" são versões mais claras
   dos acentos, usadas só em texto pequeno para atingir contraste AA. */
:root {
  --bg: #1e2e22;
  --bg-dark: #162318;
  --bg-deeper: #0f1a12;
  --green-mid: #243a28;
  --green-border: #2e4a32;

  --ektar-red: #c8341a;          /* bordas e detalhes decorativos */
  --ektar-red-text: #f07050;     /* rótulos em vermelho */
  --ektar-orange: #d4621e;
  --ektar-orange-text: #e88a4a;  /* legendas em laranja */
  --ektar-amber: #e8a830;

  --cream: #f0e8d0;              /* títulos */
  --cream-dim: #b8a880;          /* texto secundário */
  --cream-ghost: #a09070;        /* texto terciário — mínimo legível */

  --mono: 'Share Tech Mono', monospace;
  --serif: 'Playfair Display', serif;
}

/* ══ RESET + BASE ═════════════════════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--cream);
  font-family: var(--serif);
  min-height: 100vh;
  overflow-x: hidden;
}

/* Grão de filme: ruído SVG fixo por cima de tudo, sem capturar cliques */
body::after {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 999;
  pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  opacity: .05;
  mix-blend-mode: screen;
}

/* ══ NAV PRINCIPAL ════════════════════════════════════════════════════════
   :not([class]) é obrigatório: sem ele a regra também fixaria no topo o
   <nav class="article-nav"> (anterior/próximo) do fim da página. */
nav:not([class]) {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: .85rem 2rem;
  background: rgba(30,46,34,.94);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--green-border);
}

.logo {
  font-family: var(--mono);
  font-size: .9rem;
  letter-spacing: .2em;
  color: var(--cream);
  text-decoration: none;
  flex-shrink: 0;
}
.logo em { color: var(--ektar-red); font-style: normal; }

/* centro do nav: "← contact sheet" + número do frame (some em telas menores) */
.nav-center {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.nav-back {
  font-family: var(--mono);
  font-size: .8rem;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--cream-dim);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: .4rem;
  transition: color .2s;
}
.nav-back:hover { color: var(--cream); }
.nav-back::before { content: '←'; font-size: .85rem; }

.nav-frame {
  font-family: var(--mono);
  font-size: .75rem;
  letter-spacing: .12em;
  color: var(--ektar-amber);
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 1.4rem;
}
.nav-right a {
  font-family: var(--mono);
  font-size: .8rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--cream-dim);
  text-decoration: none;
  transition: color .2s;
}
.nav-right a:hover { color: var(--cream); }

/* links externos (Substack / Instagram) em formato de etiqueta */
.nav-pill {
  border: 1px solid var(--ektar-red);
  padding: .22rem .7rem;
  color: var(--ektar-red-text) !important;
}

/* botão hambúrguer — só aparece no breakpoint mobile (ver @media) */
.nav-hamburger {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  /* padding grande + margem negativa: área de toque de ~44px sem aumentar o nav */
  padding: 14px 11px;
  margin: -10px -7px;
  z-index: 101;
}
.nav-hamburger span {
  width: 22px; height: 2px;
  background: var(--cream);
  display: block;
  transition: transform .25s, opacity .2s;
}
/* estado aberto: as três barras viram um X */
.nav-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.nav-hamburger.open span:nth-child(2) { opacity: 0; }
.nav-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* ══ CAPA (tira de filme) ═════════════════════════════════════════════════ */
.article-hero {
  padding-top: 52px; /* altura do nav fixo */
  position: relative;
}

/* faixas de perfuração acima e abaixo da foto; os furos (.perf) são
   gerados por JS conforme a largura da janela */
.hero-film-strip {
  background: #100c07;
  height: 28px;
  display: flex;
  align-items: center;
  padding: 0 6px;
  border-bottom: 2px solid #0d0a05;
  overflow: hidden;
}

.perf {
  width: 14px;
  height: 10px;
  background: #030201;
  border: 1px solid #1a1409;
  border-radius: 2px;
  margin-right: 18px;
  flex-shrink: 0;
}

.hero-img-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 21/9; /* panorâmico no desktop; vira 4/3 no mobile */
  overflow: hidden;
  background: var(--bg-deeper);
}

.hero-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* carimbo laranja estilo "data back" de câmera analógica */
.hero-stamp {
  position: absolute;
  bottom: 14px;
  right: 18px;
  font-family: var(--mono);
  font-size: clamp(.8rem, 1.1vw, .95rem);
  color: #ff7800;
  letter-spacing: .14em;
  text-shadow: 0 0 6px rgba(255,120,0,.9), 0 0 14px rgba(255,80,0,.5);
  line-height: 1.6;
  text-align: right;
}

/* número do frame no canto superior esquerdo da capa */
.hero-frame-n {
  position: absolute;
  top: 10px;
  left: 14px;
  font-family: var(--mono);
  font-size: .75rem;
  color: #ff9a2e;
  letter-spacing: .12em;
  text-shadow: 0 0 5px rgba(0,0,0,.9);
}

.hero-film-strip-bot {
  background: var(--bg-deeper);
  height: 28px;
  display: flex;
  align-items: center;
  padding: 0 6px;
  overflow: hidden;
}

/* ══ CABEÇALHO DO ENSAIO ══════════════════════════════════════════════════ */
.ensaio-wrap {
  max-width: 1100px;
  margin: 0 auto;
  padding: 4rem 2rem 6rem;
}

.ensaio-header {
  margin-bottom: 3.5rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--green-border);
}

/* linha "ensaio · mês ano" acima do título */
.ensaio-eyebrow {
  font-family: var(--mono);
  font-size: .78rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--ektar-red-text);
  margin-bottom: 1.2rem;
}

.ensaio-title {
  font-family: var(--serif);
  font-size: clamp(2rem, 4vw, 3.4rem);
  line-height: 1.1;
  font-style: italic;
  font-weight: 400;
  color: var(--cream);
  margin-bottom: 1.2rem;
}

.ensaio-lead {
  font-family: var(--serif);
  font-size: 1.2rem;
  line-height: 1.7;
  color: var(--cream-dim);
  font-style: italic;
  max-width: 58ch;
}

/* ficha resumida: câmera · filme · local */
.ensaio-meta {
  margin-top: 1.2rem;
  display: flex;
  gap: .6rem 1.6rem;
  flex-wrap: wrap;
}

.ensaio-meta-item {
  font-family: var(--mono);
  font-size: .75rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--cream-ghost);
}

.ensaio-meta-item span {
  color: var(--cream-dim);
  margin-left: .4rem;
}

/* ══ GRADE DE FOTOS ═══════════════════════════════════════════════════════
   3 colunas no desktop → 2 em tablet → 1 no celular (ver @media). */
.ensaio-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.8rem;
  margin-bottom: 4rem;
}

/* card = moldura da foto + legenda; o card inteiro é clicável */
.foto-card {
  cursor: pointer;
  display: flex;
  flex-direction: column;
}

.foto-frame {
  position: relative;
  aspect-ratio: 3/2;
  overflow: hidden;
  background: var(--bg-deeper);
  border: 3px solid #100c07;
  border-bottom: none;
}

.foto-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .35s;
}

.foto-card:hover .foto-frame img {
  transform: scale(1.02);
}

/* furo decorativo no canto superior direito da moldura */
.foto-frame::before {
  content: '';
  position: absolute;
  top: 6px;
  right: 6px;
  width: 10px;
  height: 7px;
  background: #030201;
  border: 1px solid #1a1409;
  border-radius: 1px;
  z-index: 1;
  pointer-events: none;
}

/* número da foto dentro do ensaio (01, 02, …) */
.foto-num {
  position: absolute;
  bottom: 8px;
  left: 8px;
  font-family: var(--mono);
  font-size: .72rem;
  color: var(--ektar-amber);
  letter-spacing: .1em;
  text-shadow: 0 0 4px rgba(0,0,0,.9);
  pointer-events: none;
}

/* legenda — a faixa aparece mesmo vazia, para manter os cards alinhados */
.foto-caption {
  background: #100c07;
  border: 3px solid #100c07;
  border-top: none;
  padding: .4rem .6rem;
  font-family: var(--mono);
  font-size: .75rem;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--ektar-orange-text);
  min-height: 1.8rem;
  line-height: 1.5;
}

/* ══ NAVEGAÇÃO ENTRE TEXTOS (anterior / próximo) ══════════════════════════ */
.article-nav {
  margin-top: 4rem;
  padding-top: 2rem;
  border-top: 1px solid var(--green-border);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.article-nav-link {
  text-decoration: none;
  padding: 1rem;
  border: 1px solid var(--green-border);
  transition: border-color .2s, background .2s;
  display: block;
}

.article-nav-link:hover {
  border-color: var(--cream-ghost);
  background: rgba(255,255,255,.02);
}

.article-nav-link.next { text-align: right; }

.anl-dir {
  font-family: var(--mono);
  font-size: .72rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--ektar-red-text);
  margin-bottom: .4rem;
}

.anl-title {
  font-family: var(--serif);
  font-size: 1rem;
  font-style: italic;
  color: var(--cream-dim);
  line-height: 1.35;
}

/* ══ RODAPÉ ═══════════════════════════════════════════════════════════════ */
footer {
  border-top: 1px solid var(--green-border);
  padding: 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer-logo {
  font-family: var(--mono);
  font-size: .85rem;
  letter-spacing: .15em;
  color: var(--cream);
}
.footer-logo em { color: var(--ektar-red); font-style: normal; }

.footer-links { display: flex; gap: 1.5rem; }
.footer-links a {
  font-family: var(--mono);
  font-size: .75rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--cream-ghost);
  text-decoration: none;
  transition: color .2s;
}
.footer-links a:hover { color: var(--cream); }

/* ══ LIGHTBOX ═════════════════════════════════════════════════════════════
   Tela cheia sobre a página (z-index acima do grão de filme).
   Fica oculto até receber a classe .open via JS. */
.lightbox {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(10,14,11,.96);
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.lightbox.open { display: flex; }

.lightbox-img-wrap {
  position: relative;
  max-width: 90vw;
  max-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* a foto nunca é cortada: encolhe para caber em 90% × 80% da tela */
.lightbox-img-wrap img {
  max-width: 90vw;
  max-height: 80vh;
  object-fit: contain;
  display: block;
}

.lightbox-close {
  position: fixed;
  top: 1.2rem;
  right: 1.6rem;
  background: none;
  border: none;
  color: var(--cream-dim);
  font-family: var(--mono);
  font-size: 1.4rem;
  cursor: pointer;
  z-index: 1;
  padding: .4rem;
  transition: color .2s;
}
.lightbox-close:hover { color: var(--cream); }

/* setas ‹ › nas laterais, centralizadas na vertical */
.lightbox-nav {
  position: fixed;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: var(--cream-dim);
  font-family: var(--mono);
  font-size: 1.6rem;
  cursor: pointer;
  padding: 1rem;
  transition: color .2s;
  z-index: 1;
}
.lightbox-nav:hover { color: var(--cream); }
.lightbox-prev { left: 1rem; }
.lightbox-next { right: 1rem; }

.lightbox-meta {
  margin-top: 1.2rem;
  text-align: center;
}

/* contador "3 / 7" */
.lightbox-num {
  font-family: var(--mono);
  font-size: .8rem;
  letter-spacing: .16em;
  color: var(--ektar-amber);
  margin-bottom: .3rem;
}

.lightbox-caption {
  font-family: var(--mono);
  font-size: .8rem;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--cream-dim);
  min-height: 1rem;
}

/* ══ RESPONSIVO ═══════════════════════════════════════════════════════════
   ≤ 1000px: o nav perde o bloco central (não cabe ao lado dos links).
   ≤ 800px : menu hambúrguer, grade de 2 colunas.
   ≤ 480px : grade de 1 coluna. */
@media (max-width: 1000px) {
  .nav-center { display: none; }
}

@media (max-width: 800px) {
  nav:not([class]) { padding: .8rem 1.2rem; }
  .nav-hamburger { display: flex; }

  /* menu vira painel suspenso logo abaixo do nav (49px = altura do nav mobile) */
  .nav-right {
    display: none;
    position: fixed;
    top: 49px; left: 0; right: 0;
    background: rgba(22,35,24,.98);
    flex-direction: column;
    align-items: flex-start;
    padding: 1.8rem 2rem;
    gap: 1.4rem;
    border-bottom: 1px solid #243a28;
    z-index: 102;
  }
  .nav-right.open { display: flex; }
  .nav-right a { font-size: 1rem; letter-spacing: .14em; }

  .hero-img-wrap { aspect-ratio: 4/3; }
  .ensaio-wrap { padding: 2.5rem 1.2rem 4rem; }
  .ensaio-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  footer { flex-direction: column; gap: 1rem; text-align: center; }

  /* setas menores e coladas na borda, para não cobrir a foto */
  .lightbox-nav { font-size: 1.4rem; padding: .8rem .5rem; }
  .lightbox-prev { left: 0; }
  .lightbox-next { right: 0; }
}

@media (max-width: 480px) {
  .ensaio-grid { grid-template-columns: 1fr; }
}

/* telas muito estreitas: anterior/próximo empilhados */
@media (max-width: 420px) {
  .article-nav { grid-template-columns: 1fr; }
  .article-nav-link.next { text-align: left; }
}
</style>
</head>
<body>

{# ── NAV ─────────────────────────────────────────────────────────────────
   Mesma versão do article.njk (não usa nav.njk) por causa do bloco
   central com "voltar" e número do frame. #}
<nav aria-label="Navegação principal">
  <a href="{{ '/' | url }}" class="logo" aria-label="br.trombin — página inicial">br<em>.</em>trombin</a>
  <div class="nav-center">
    <a href="{{ '/' | url }}" class="nav-back">contact sheet</a>
    <span class="nav-frame">frame {{ frameNumber }} / 99exp</span>
  </div>
  <div class="nav-right" id="nav-menu">
    <a href="{{ '/sobre/' | url }}">sobre</a>
    <a href="{{ '/galeria.html' | url }}">galeria</a>
    <a href="https://naocabe.substack.com" target="_blank" rel="noopener" class="nav-pill">Substack</a>
    <a href="https://www.instagram.com/brtrombin" target="_blank" rel="noopener" class="nav-pill">Instagram</a>
  </div>
  <button class="nav-hamburger" id="nav-toggle" aria-label="abrir menu" aria-expanded="false" aria-controls="nav-menu">
    <span></span><span></span><span></span>
  </button>
</nav>

{# ── CAPA ────────────────────────────────────────────────────────────────
   Foto de capa entre duas faixas de perfuração preenchidas por JS. #}
<div class="article-hero">
  <div class="hero-film-strip" id="perfs-top"></div>
  <div class="hero-img-wrap">
    {% if hero_image %}
    <img src="{{ hero_image | url }}" alt="{{ title }}">
    {% endif %}
    <span class="hero-frame-n">{{ frameNumber }}</span>
    {# carimbo: local / data / filme — cada linha só aparece se o dado existir #}
    <div class="hero-stamp">
      {% if location %}{{ location }}<br>{% endif %}
      {{ date | dateStamp }}{% if film %}<br>{{ film }}{% endif %}
    </div>
  </div>
  <div class="hero-film-strip-bot" id="perfs-bot"></div>
</div>

<div class="ensaio-wrap">

  {# ── CABEÇALHO ─────────────────────────────────────────────────────── #}
  <header class="ensaio-header">
    <p class="ensaio-eyebrow">ensaio &middot; {{ date | dateLong }}</p>
    <h1 class="ensaio-title">{{ title }}</h1>
    {% if lead %}
    <p class="ensaio-lead">{{ lead }}</p>
    {% endif %}
    {% if camera or film %}
    <div class="ensaio-meta">
      {% if camera %}<div class="ensaio-meta-item">câmera<span>{{ camera }}</span></div>{% endif %}
      {% if film %}<div class="ensaio-meta-item">filme<span>{{ film }}</span></div>{% endif %}
      {% if location %}<div class="ensaio-meta-item">local<span>{{ location }}</span></div>{% endif %}
    </div>
    {% endif %}
  </header>

  {# ── GRADE DE FOTOS ────────────────────────────────────────────────────
     Cada card funciona como botão (role + tabindex) e abre o lightbox na
     foto correspondente; data-index é a posição da foto na lista. #}
  {% if images %}
  <div class="ensaio-grid" id="ensaio-grid">
    {% for img in images %}
    <div class="foto-card" data-index="{{ loop.index0 }}" role="button" tabindex="0" aria-label="abrir foto {{ loop.index }}">
      <div class="foto-frame">
        <img src="{{ img.src | url }}" alt="{{ img.caption or (title + ' — foto ' + loop.index) }}" loading="lazy">
        {# numeração com zero à esquerda: 01, 02, … #}
        <span class="foto-num">{% if loop.index < 10 %}0{{ loop.index }}{% else %}{{ loop.index }}{% endif %}</span>
      </div>
      <div class="foto-caption">{% if img.caption %}{{ img.caption }}{% endif %}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {# prev = publicação mais antiga, next = mais recente (definidos no .eleventy.js).
     O <div> vazio mantém "próximo" na coluna da direita quando não há anterior. #}
  <nav class="article-nav" aria-label="Outros textos">
    {% if prevArticle %}
    <a href="{{ prevArticle.url }}" class="article-nav-link prev">
      <p class="anl-dir">← anterior</p>
      <p class="anl-title">{{ prevArticle.data.title }}</p>
    </a>
    {% else %}
    <div></div>
    {% endif %}
    {% if nextArticle %}
    <a href="{{ nextArticle.url }}" class="article-nav-link next">
      <p class="anl-dir">próximo →</p>
      <p class="anl-title">{{ nextArticle.data.title }}</p>
    </a>
    {% endif %}
  </nav>

</div>

{# ── LIGHTBOX ────────────────────────────────────────────────────────────
   Um único visualizador para todas as fotos; o JS troca src/legenda. #}
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Visualizador de fotos">
  <button class="lightbox-close" id="lb-close" aria-label="fechar">✕</button>
  <button class="lightbox-nav lightbox-prev" id="lb-prev" aria-label="foto anterior">‹</button>
  <div class="lightbox-img-wrap">
    <img id="lb-img" src="" alt="">
  </div>
  <button class="lightbox-nav lightbox-next" id="lb-next" aria-label="próxima foto">›</button>
  <div class="lightbox-meta">
    <p class="lightbox-num" id="lb-num"></p>
    <p class="lightbox-caption" id="lb-caption"></p>
  </div>
</div>

<footer>
  <span class="footer-logo">br<em>.</em>trombin</span>
  <div class="footer-links">
    <a href="{{ '/' | url }}">contact sheet</a>
    <a href="https://naocabe.substack.com" target="_blank" rel="noopener">Substack</a>
    <a href="https://www.instagram.com/brtrombin" target="_blank" rel="noopener">Instagram</a>
  </div>
</footer>

<script>
// ── Perfurações da tira de filme ─────────────────────────────────────────
// Preenche a faixa com furos suficientes para a largura atual da janela
// (cada furo ocupa 32px: 14 de largura + 18 de margem).
function makePerfs(id) {
  var el = document.getElementById(id);
  if (!el) return;
  var n = Math.ceil(window.innerWidth / 32) + 2;
  el.innerHTML = Array(n).fill('<div class="perf"></div>').join('');
}
makePerfs('perfs-top');
makePerfs('perfs-bot');
window.addEventListener('resize', function() { makePerfs('perfs-top'); makePerfs('perfs-bot'); });

// ── Menu hambúrguer (mobile) ─────────────────────────────────────────────
(function() {
  var toggle = document.getElementById("nav-toggle");
  var menu   = document.getElementById("nav-menu");
  if (!toggle || !menu) return;

  // abre/fecha ao tocar no botão
  toggle.addEventListener("click", function() {
    var open = menu.classList.toggle("open");
    toggle.classList.toggle("open", open);
    toggle.setAttribute("aria-expanded", String(open));
  });

  // fecha ao tocar fora do menu
  document.addEventListener("click", function(e) {
    if (!menu.contains(e.target) && !toggle.contains(e.target)) {
      menu.classList.remove("open");
      toggle.classList.remove("open");
      toggle.setAttribute("aria-expanded", "false");
    }
  });

  // fecha ao escolher um link
  menu.querySelectorAll("a").forEach(function(a) {
    a.addEventListener("click", function() {
      menu.classList.remove("open");
      toggle.classList.remove("open");
      toggle.setAttribute("aria-expanded", "false");
    });
  });
})();

// ── Lightbox ─────────────────────────────────────────────────────────────
(function() {
  var images = [];   // { src, alt, caption } de cada foto da grade
  var current = 0;   // índice da foto aberta
  var lb      = document.getElementById("lightbox");
  var lbImg   = document.getElementById("lb-img");
  var lbNum   = document.getElementById("lb-num");
  var lbCap   = document.getElementById("lb-caption");

  // Lê os dados das fotos direto do HTML da grade
  document.querySelectorAll(".foto-card").forEach(function(card) {
    var img = card.querySelector("img");
    var cap = card.querySelector(".foto-caption");
    images.push({
      src:     img ? img.src : "",
      alt:     img ? img.alt : "",
      caption: cap ? cap.textContent.trim() : ""
    });
  });

  // Abre a foto idx; o módulo faz a navegação dar a volta
  // (antes da primeira → última, depois da última → primeira)
  function open(idx) {
    current = (idx + images.length) % images.length;
    lbImg.src = images[current].src;
    lbImg.alt = images[current].alt;
    lbNum.textContent = (current + 1) + " / " + images.length;
    lbCap.textContent = images[current].caption;
    lb.classList.add("open");
    document.body.style.overflow = "hidden"; // trava a rolagem da página atrás
  }

  function close() {
    lb.classList.remove("open");
    lbImg.src = "";
    document.body.style.overflow = "";
  }

  // Abrir: clique no card, ou Enter/Espaço com o card em foco
  document.querySelectorAll(".foto-card").forEach(function(card, i) {
    card.addEventListener("click", function() { open(i); });
    card.addEventListener("keydown", function(e) { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); open(i); } });
  });

  document.getElementById("lb-close").addEventListener("click", close);
  document.getElementById("lb-prev").addEventListener("click", function() { open(current - 1); });
  document.getElementById("lb-next").addEventListener("click", function() { open(current + 1); });

  // Fechar ao clicar no fundo escuro (fora da foto e dos botões)
  lb.addEventListener("click", function(e) {
    if (e.target === lb) close();
  });

  // Teclado: Esc fecha, setas navegam
  document.addEventListener("keydown", function(e) {
    if (!lb.classList.contains("open")) return;
    if (e.key === "Escape")     close();
    if (e.key === "ArrowLeft")  open(current - 1);
    if (e.key === "ArrowRight") open(current + 1);
  });
})();
</script>
</body>
</html>
